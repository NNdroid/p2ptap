#: luasrc/controller/p2ptap.lua:8
msgid "p2ptap"
msgstr "p2ptap"

#: luasrc/model/cbi/p2ptap.lua:3
msgid "p2ptap 控制台"
msgstr "p2ptap コンソール"

#: luasrc/model/cbi/p2ptap.lua:4
msgid "基于 go-libp2p 的二层 P2P TAP 点对点虚拟局域网。支持全功能参数配置、网络传输调优、流量混淆、出口网关模式、一键服务控制及内置 WebUI 管理入口。"
msgstr "go-libp2p ベースのレイヤー2 P2P TAP 仮想LAN。フルパラメータ設定、トランスポート最適化、トラフィック難読化、出口ゲートウェイモード、ワンクリックサービス制御、内蔵 WebUI 管理をサポートします。"

#: luasrc/model/cbi/p2ptap.lua:9
msgid "运行状态"
msgstr "稼働状態"

#: luasrc/model/cbi/p2ptap.lua:11
msgid "服务运行状态"
msgstr "サービス稼働状態"

#: luasrc/model/cbi/p2ptap.lua:17
msgid "基础与网络配置"
msgstr "基本・ネットワーク設定"

#: luasrc/model/cbi/p2ptap.lua:19
msgid "基本配置"
msgstr "基本設定"

#: luasrc/model/cbi/p2ptap.lua:20
msgid "虚拟网卡与IP拓扑"
msgstr "仮想NIC・IPトポロジー"

#: luasrc/model/cbi/p2ptap.lua:21
msgid "节点与监听配置"
msgstr "ノード・リスン設定"

#: luasrc/model/cbi/p2ptap.lua:24
msgid "启用 p2ptap 服务"
msgstr "p2ptap サービスを有効化"

#: luasrc/model/cbi/p2ptap.lua:27
msgid "节点名称 (Node Name)"
msgstr "ノード名 (Node Name)"

#: luasrc/model/cbi/p2ptap.lua:30
msgid "网络中标识本路由器的名称，留空默认使用系统 Hostname。"
msgstr "ネットワーク内でこのルーターを識別する名前。空の場合はシステムのホスト名を使用します。"

#: luasrc/model/cbi/p2ptap.lua:32
msgid "日志记录级别 (Log Level)"
msgstr "ログレベル (Log Level)"

#: luasrc/model/cbi/p2ptap.lua:33
msgid "调试 (Debug)"
msgstr "デバッグ (Debug)"

#: luasrc/model/cbi/p2ptap.lua:34
msgid "信息 (Info)"
msgstr "情報 (Info)"

#: luasrc/model/cbi/p2ptap.lua:35
msgid "警告 (Warn)"
msgstr "警告 (Warn)"

#: luasrc/model/cbi/p2ptap.lua:36
msgid "错误 (Error)"
msgstr "エラー (Error)"

#: luasrc/model/cbi/p2ptap.lua:39
msgid "预共享密钥 (PSK)"
msgstr "事前共有鍵 (PSK)"

#: luasrc/model/cbi/p2ptap.lua:42
msgid "设置 64 位 Hex 秘钥形成私有隔离加密网络。只与相同 PSK 的节点组网。留空则仅通过 mDNS + Static Peers 发现节点。"
msgstr "64文字の16進数キーでプライベート分離暗号化ネットワークを形成します。同じPSKを持つノードのみがメッシュを構成します。空の場合はmDNS + Static Peersでノードを検出します。"

#: luasrc/model/cbi/p2ptap.lua:46
msgid "PSK 必须为 64 位的十六进制(Hex)字符序列！"
msgstr "PSKは64文字の16進数（Hex）シーケンスである必要があります！"

#: luasrc/model/cbi/p2ptap.lua:52
msgid "身份私钥文件路径 (Node Key File)"
msgstr "ノード鍵ファイル (Node Key File)"

#: luasrc/model/cbi/p2ptap.lua:57
msgid "传输多径策略 (Transport Strategy)"
msgstr "トランスポート戦略 (Transport Strategy)"

#: luasrc/model/cbi/p2ptap.lua:58
msgid "最优路径 (Best Path - 低延迟自动优选)"
msgstr "最適パス (Best Path — 低遅延自動選択)"

#: luasrc/model/cbi/p2ptap.lua:59
msgid "多径双发 (Redundant - 极速双发抗丢包)"
msgstr "冗長送信 (Redundant — 高速二重送信でパケットロス耐性)"

#: luasrc/model/cbi/p2ptap.lua:60
msgid "自动退避 (Fallback - 稳定保底)"
msgstr "フォールバック (Fallback — 安定した安全策)"

#: luasrc/model/cbi/p2ptap.lua:64
msgid "TAP 虚拟网卡名称"
msgstr "TAP インターフェース名"

#: luasrc/model/cbi/p2ptap.lua:68
msgid "虚拟 IPv4 地址/掩码 (TAP IPv4 CIDR)"
msgstr "仮想IPv4アドレス/ネットマスク (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:71
msgid "例如 10.0.0.1/24。同局域网各节点 IP 地址必须在同一网段且保持唯一。"
msgstr "例: 10.0.0.1/24。同一LAN内の全ノードIPは同じサブネット内で一意である必要があります。"

#: luasrc/model/cbi/p2ptap.lua:73
msgid "虚拟 IPv6 地址/前缀 (TAP IPv6 CIDR)"
msgstr "仮想IPv6アドレス/プレフィックス (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:75
msgid "例如 fd00::1/64。提供原生二层 IPv6 组网能力。"
msgstr "例: fd00::1/64。ネイティブレイヤー2 IPv6 ネットワーキングを提供します。"

#: luasrc/model/cbi/p2ptap.lua:79
msgid "IPv6 地址格式错误！必须为带前缀格式 (如 fd00::1/64)"
msgstr "IPv6アドレス形式が無効です！プレフィックス付き形式が必要です（例: fd00::1/64）"

#: luasrc/model/cbi/p2ptap.lua:85
msgid "TAP 网卡 MAC 地址 (TAP MAC)"
msgstr "TAP MAC アドレス"

#: luasrc/model/cbi/p2ptap.lua:88
msgid "虚拟网卡的二层 MAC 地址。如留空将自动随机生成并持久化。"
msgstr "仮想インターフェースのレイヤー2 MACアドレス。空にするとランダム生成され永続化されます。"

#: luasrc/model/cbi/p2ptap.lua:90
msgid "接口最大传输单元 (MTU)"
msgstr "インターフェース MTU"

#: luasrc/model/cbi/p2ptap.lua:93
msgid "推荐默认 1500 (范围: 68-9000)。"
msgstr "デフォルト値 1500 を推奨 (範囲: 68–9000)。"

#: luasrc/model/cbi/p2ptap.lua:95
msgid "启用 mDNS 局域网节点发现"
msgstr "mDNS LAN ノード検出を有効化"

#: luasrc/model/cbi/p2ptap.lua:97
msgid "本地局域网内自动发现其他 P2P 节点。"
msgstr "ローカルLAN内で他のP2Pノードを自動検出します。"

#: luasrc/model/cbi/p2ptap.lua:99
msgid "TAP 驱动类型 (Driver Type)"
msgstr "TAP ドライバータイプ (Driver Type)"

#: luasrc/model/cbi/p2ptap.lua:100
msgid "自动检测 (Auto)"
msgstr "自動検出 (Auto)"

#: luasrc/model/cbi/p2ptap.lua:101
msgid "TAP 驱动 (Linux/macOS)"
msgstr "TAP ドライバー (Linux/macOS)"

#: luasrc/model/cbi/p2ptap.lua:102
msgid "WinTun 驱动 (Windows)"
msgstr "WinTun ドライバー (Windows)"

#: luasrc/model/cbi/p2ptap.lua:104
msgid "Windows 系统推荐 wintun，其他系统使用 auto 即可。"
msgstr "Windowsではwintunを推奨、他のOSではautoを使用してください。"

#: luasrc/model/cbi/p2ptap.lua:107
msgid "引导节点列表 (Bootstrap Peers)"
msgstr "ブートストラップピア (Bootstrap Peers)"

#: luasrc/model/cbi/p2ptap.lua:109
msgid "公共或私有的 P2P 引导节点 Multiaddr 列表。多行输入，每行一条。"
msgstr "パブリックまたはプライベートのP2PブートストラップノードのMultiaddrリスト。1行に1つずつ入力してください。"

#: luasrc/model/cbi/p2ptap.lua:111
msgid "静态直连节点 (Static Peers)"
msgstr "静的ピア (Static Peers)"

#: luasrc/model/cbi/p2ptap.lua:113
msgid "手动指定直连对端节点的 Multiaddr。"
msgstr "直接接続するピアノードのMultiaddrを手動で指定します。"

#: luasrc/model/cbi/p2ptap.lua:115
msgid "本地 P2P 监听地址 (Listen Multiaddrs)"
msgstr "ローカルリスンMultiaddr (Listen Multiaddrs)"

#: luasrc/model/cbi/p2ptap.lua:117
msgid "本地监听的多地址 Multiaddr 列表。支持 QUIC/WebRTC/WebTransport/TCP。"
msgstr "ローカルでリスンするMultiaddrリスト。QUIC/WebRTC/WebTransport/TCPに対応。"

#: luasrc/model/cbi/p2ptap.lua:122
msgid "传输协议高级设置"
msgstr "トランスポートプロトコル詳細設定"

#: luasrc/model/cbi/p2ptap.lua:125
msgid "启用 QUIC v1 传输协议"
msgstr "QUIC v1 トランスポートを有効化"

#: luasrc/model/cbi/p2ptap.lua:128
msgid "启用 WebRTC Direct 穿透协议"
msgstr "WebRTC Direct NAT越えを有効化"

#: luasrc/model/cbi/p2ptap.lua:130
msgid "基于浏览器/原生 WebRTC 的 NAT 穿透传输层。"
msgstr "ブラウザ/ネイティブ WebRTC ベースのNAT越えトランスポートレイヤー。"

#: luasrc/model/cbi/p2ptap.lua:132
msgid "启用 WebTransport 协议"
msgstr "WebTransport を有効化"

#: luasrc/model/cbi/p2ptap.lua:134
msgid "基于 HTTP/3 QUIC 的新型传输协议。"
msgstr "HTTP/3 QUIC ベースの新世代トランスポートプロトコル。"

#: luasrc/model/cbi/p2ptap.lua:136
msgid "启用 TCP 复用协议"
msgstr "TCP多重化を有効化"

#: luasrc/model/cbi/p2ptap.lua:141
msgid "高吞吐场景的激进 TCP 拥塞算法。需内核支持。"
msgstr "高スループットシナリオ向けのアグレッシブなTCP輻輳アルゴリズム。カーネルサポートが必要です。"

#: luasrc/model/cbi/p2ptap.lua:151
msgid "流量混淆与数据填充"
msgstr "トラフィック難読化・パディング"

#: luasrc/model/cbi/p2ptap.lua:154
msgid "启用二层数据包流量混淆"
msgstr "レイヤー2パケット難読化を有効化"

#: luasrc/model/cbi/p2ptap.lua:203
msgid "自动切换阈值 (Auto Threshold Bytes)"
msgstr "自動切替閾値 (バイト)"

#: luasrc/model/cbi/p2ptap.lua:206
msgid "Auto 模式下累计传输超过此字节数后触发重评估。默认 1MB。"
msgstr "Autoモードで累積転送がこのバイト数を超えたら再評価をトリガーします。デフォルト: 1MB。"

#: luasrc/model/cbi/p2ptap.lua:217
msgid "出口网关 (Exit Node)"
msgstr "出口ゲートウェイ (Exit Node)"

#: luasrc/model/cbi/p2ptap.lua:220
msgid "启用出口网关模式 (Enable Exit Node)"
msgstr "出口ゲートウェイモードを有効化"

#: luasrc/model/cbi/p2ptap.lua:222
msgid "启用后本节点允许对端节点通过本机访问外部网络。相当于 P2P VPN 网关。"
msgstr "有効にすると、ピアノードがこのノード経由で外部ネットワークにアクセスできます。P2P VPNゲートウェイとして機能します。"

#: luasrc/model/cbi/p2ptap.lua:224
msgid "启用 NAT 伪装 (NAT Masquerade)"
msgstr "NATマスカレードを有効化"

#: luasrc/model/cbi/p2ptap.lua:226
msgid "为转发的出站流量自动添加 SNAT 规则 (iptables MASQUERADE)。"
msgstr "転送される外向きトラフィックにSNATルール（iptables MASQUERADE）を自動追加します。"

#: luasrc/model/cbi/p2ptap.lua:229
msgid "出口物理网卡 (WAN Interface)"
msgstr "WANインターフェース (WAN Interface)"

#: luasrc/model/cbi/p2ptap.lua:232
msgid "提供外部网络出口的物理网卡名称，如 eth0 / wan / pppoe-wan。填写 'auto' 自动检测默认路由网卡。"
msgstr "外部ネットワーク出口を提供する物理インターフェース名（例: eth0 / wan / pppoe-wan）。'auto'と入力するとデフォルトルートのインターフェースを自動検出します。"

#: luasrc/model/cbi/p2ptap.lua:238
msgid "WebUI 控制台"
msgstr "WebUI コンソール"

#: luasrc/model/cbi/p2ptap.lua:241
msgid "启用内置 WebUI Dashboard"
msgstr "内蔵 WebUI ダッシュボードを有効化"

#: luasrc/model/cbi/p2ptap.lua:244
msgid "WebUI 监听 IPv4 地址"
msgstr "WebUI リスンIPv4アドレス"

#: luasrc/model/cbi/p2ptap.lua:247
msgid "WebUI Dashboard 绑定的 IPv4 监听地址，0.0.0.0 表示监听所有接口。"
msgstr "WebUIダッシュボードのIPv4リスンアドレス。0.0.0.0は全インターフェースでリスンします。"

#: luasrc/model/cbi/p2ptap.lua:249
msgid "WebUI 监听 IPv6 地址"
msgstr "WebUI リスンIPv6アドレス"

#: luasrc/model/cbi/p2ptap.lua:252
msgid "WebUI Dashboard 绑定的 IPv6 监听地址，:: 表示监听所有接口。"
msgstr "WebUIダッシュボードのIPv6リスンアドレス。:: は全インターフェースでリスンします。"

#: luasrc/model/cbi/p2ptap.lua:254
msgid "WebUI 监听端口 (Port)"
msgstr "WebUI リスンポート (Port)"

#: luasrc/model/cbi/p2ptap.lua:258
msgid "控制台快捷入口"
msgstr "コンソールクイックアクセス"

#: luasrc/view/p2ptap/status.htm:7
msgid "运行中 (Running)"
msgstr "稼働中"

#: luasrc/view/p2ptap/status.htm:9
msgid "未运行 (Stopped)"
msgstr "停止中"

#: luasrc/view/p2ptap/status.htm:15
msgid "正在获取运行状态..."
msgstr "稼働状態を取得中..."


msgid "多径调度 (Multipath - 跨路径重排/抗丢包)"
msgstr "マルチパススケジューリング（経路間の再順序付け/損失耐性）"

msgid "multipath 下接收端开启重排缓冲，可结合 rx_reorder_window / rx_reorder_delay_ms 调优。"
msgstr "multipath では受信側で並べ替えバッファが有効になり、rx_reorder_window / rx_reorder_delay_ms で調整できます。"

msgid "统计采样率 (Stats Sample Every)"
msgstr "統計サンプル間隔 (Stats Sample Every)"

msgid "每 N 帧记录一次报文分类统计。1 = 全量记录 (默认)。高吞吐部署可提升至 16-64 降低 CPU。字节/包速率统计始终精确。"
msgstr "N フレームごとにパケット分類統計を記録します。1 = 全記録（既定）。高スループット環境では 16〜64 に上げて CPU を抑えられます。バイト/パケットレート統計は常に正確です。"

msgid "强制私有可达性 (Force Private Reachability)"
msgstr "プライベート到達性を強制 (Force Private Reachability)"

msgid "强制 libp2p 主机宣告为私有 (仅中继可达)。默认关闭: 通过 AutoNAT 自动检测，公网节点仍宣告直连地址。仅当 AutoNAT 在您的网络中不可靠时启用。"
msgstr "libp2p ホストをプライベート（リレーのみ）として宣伝させます。既定はオフ：AutoNAT で自動検出されるため、パブリックノードは直接アドレスを宣伝します。AutoNAT が信頼できないネットワークでのみ有効にしてください。"

msgid "启用 WebRTC 信令穿透 (WebRTC Signaling)"
msgstr "WebRTC シグナリング NAT 越えを有効化 (WebRTC Signaling)"

msgid "中继专用对端无法直连时，通过控制通道交换真实 SDP 并运行完整 ICE (STUN/TURN)，可穿越一层或两层 NAT。独立于 webrtc-direct (LITE 无法穿 NAT)。需重启生效。"
msgstr "リレーのみのピアに直接到達できない場合、制御チャネルで実際の SDP を交換し、完全な ICE（STUN/TURN）を実行して 1〜2 つの NAT を越えます。webrtc-direct（LITE は NAT を越えられない）とは別です。再起動が必要です。"

msgid "TLS SNI 服务器名 (TLS Server Name)"
msgstr "TLS SNI サーバー名 (TLS Server Name)"

msgid "留空表示不发送 SNI"
msgstr "空にすると SNI を送信しません"

msgid "出站握手 (TLS-over-TCP 与 QUIC) 的 server_name (SNI)。设置后使网格流量更接近普通 HTTP/3。不影响认证。"
msgstr "送信ハンドシェイク（TLS-over-TCP と QUIC）の server_name (SNI)。設定するとメッシュトラフィックが通常の HTTP/3 に似たものになります。認証には影響しません。"

msgid "按 Peer 派生 SNI 后缀 (TLS SNI Suffix)"
msgstr "ピアごとの派生 SNI サフィックス (TLS SNI Suffix)"

msgid "例如 vpn.example.com"
msgstr "例: vpn.example.com"

msgid "出站 SNI 变为 '<peer 标签>.<后缀>'，使每个链路呈现稳定且不同的 SNI，避免所有节点发送相同 SNI 的全局关联特征。优先于 tls_server_name。需重启生效。"
msgstr "送信 SNI は '<ピアラベル>.<サフィックス>' になり、各リンクに安定した異なる SNI を与え、全ノードが同一 SNI を送る相関特徴を回避します。tls_server_name より優先されます。再起動が必要です。"

msgid "禁用 Circuit Relay 标准中继"
msgstr "Circuit Relay を無効化"

msgid "仅关闭 libp2p circuit-relay 与 AutoRelay，保留 DCUtR 打洞。"
msgstr "libp2p の circuit-relay と AutoRelay のみをオフにし、DCUtR ホールパンチングは維持します。"

msgid "禁用 DCUtR 打洞"
msgstr "DCUtR ホールパンチングを無効化"

msgid "仅关闭 DCUtR 打洞，保留 Circuit Relay 与 AutoRelay。"
msgstr "DCUtR ホールパンチングのみをオフにし、Circuit Relay と AutoRelay は維持します。"

msgid "禁用全部中继与打洞 (诊断)"
msgstr "全リレーとホールパンチングを無効化（診断）"

msgid "一次性关闭 Circuit Relay + AutoRelay + DCUtR，仅依赖直连或 p2ptap 专有骨干中继。不影响 p2ptap 自身 overlay 中继。"
msgstr "Circuit Relay + AutoRelay + DCUtR を一括でオフにし、直接接続または p2ptap のバックボーンリレーのみに依存します。p2ptap 自身のオーバーレイリレーには影響しません。"

msgid "overlay 中继帧使用 multihash 头"
msgstr "オーバーレイリレーフレームに multihash ヘッダーを使用"

msgid "以紧凑 0x03 头发送 p2ptap overlay 中继帧 (Peer ID 用原始 multihash 而非 base58 CID)。默认关闭: 仅当整个传输路径上所有 overlay 中继与 boot 中继都已升级时启用，否则中间 v2 节点会丢弃帧。读取端始终兼容两种头。"
msgstr "p2ptap オーバーレイリレーフレームをコンパクトな 0x03 ヘッダーで送信します（Peer ID を base58 CID ではなく生の multihash バイトで）。既定はオフ：転送経路上の全オーバーレイリレーとブートリレーがアップグレードされている場合のみ有効にしてください。中間の v2 ノードはフレームを破棄します。読み取り側は常に両ヘッダーを受け入れます。"

msgid "STUN 服务器 (WebRTC ICE)"
msgstr "STUN サーバー (WebRTC ICE)"

msgid "WebRTC ICE 候选收集的 STUN 服务器 Multiaddr。提供 server-reflexive 候选，显著提升 WebRTC 打洞成功率。留空则仅依赖 host 候选。"
msgstr "WebRTC ICE 候補収集用の STUN サーバーマルチアドレス。server-reflexive 候補を提供し、WebRTC ホールパンチング成功率を大幅に向上させます。空にするとホスト候補のみに依存します。"

msgid "TURN 服务器 (WebRTC 中继回退)"
msgstr "TURN サーバー (WebRTC リレー代替)"

msgid "TURN 中继回退 URL。必须携带凭据，否则 WebRTC 会整体中止。留空为正确默认: 走 STUN + 打洞，TURN 仅作回退。"
msgstr "TURN リレー代替 URL。資格情報が必須で、ないと WebRTC 全体が中断します。空が正しい既定：STUN + ホールパンチング、TURN は代替のみ。"

msgid "接收端重排缓冲 (Rx Reorder Window)"
msgstr "受信並べ替えウィンドウ (Rx Reorder Window)"

msgid "multipath 策略下的接收端重排缓冲帧数上限。匹配去重容忍度 (1024)。"
msgstr "multipath 戦略での受信側並べ替えバッファの最大フレーム数。重複排除許容度 (1024) に一致します。"

msgid "重排队头超时 (Rx Reorder Delay, ms)"
msgstr "受信並べ替え遅延 (Rx Reorder Delay, ms)"

msgid "multipath 下队头阻塞的强制释放超时毫秒数。默认 300ms 覆盖 LAN+WAN 直连路径的延迟差；混合 RTT 差更大的路径可调高。"
msgstr "multipath での先頭ブロッキング強制解放タイムアウト (ms)。既定 300ms は LAN+WAN 直接経路ペアのレイテンシばらつきをカバーします。RTT 差が大きい経路では上げてください。"

msgid "填充规则 (Padding Rules)"
msgstr "パディング規則 (Padding Rules)"

msgid "每行一条填充带规则，语法: '<floor> -> <target_min>[-<target_max>]'。可选一行 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' 控制包聚合。留空使用默认规则 '0 -> 400-600' (小于 400 字节填充到 400-600 随机长度，400 以上原样发送，并启用聚合)。带区间按 floor 升序。"
msgstr "1 行に 1 つのパディングバンド、構文: '<floor> -> <target_min>[-<target_max>]'。オプションで 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' 行によりパケット結合を制御します。空にすると既定規則 '0 -> 400-600'（400 バイト未満はランダムな 400-600 にパディング、400 以上はそのまま送信、結合オン）。バンドは floor 昇順です。"

msgid "分片上限 (Max Frag Size)"
msgstr "最大フラグメントサイズ (Max Frag Size)"

msgid "TAP 帧分片层的单分片内层大小上限 (字节)。0 = 由节点根据 MTU 与混淆开销自动推导。范围 256-1400。"
msgstr "TAP フレーム断片化層のフラグメントあたり内部サイズ上限（バイト）。0 = MTU と難読化オーバーヘッドからノードが自動導出。範囲 256-1400。"

msgid "严格密钥协商 (Strict Key Negotiation)"
msgstr "厳密な鍵交渉 (Strict Key Negotiation)"

msgid "强制每对 Peer 用一次性 ECDH(P256) 临时密钥派生独立密钥 (前向保密)。关闭则允许在重同步时退回到长寿命节点密钥。"
msgstr "各ピアペアに使い捨て ECDH(P256) 一時鍵から独自の暗号を導出させます（前方秘匿）。オフでは再同期時に長期ノード鍵へのフォールバックを許可します。"

msgid "强制认证密钥交换 (Require Auth Key Exchange)"
msgstr "認証鍵交換を必須化 (Require Auth Key Exchange)"

msgid "对每个 Peer 强制身份签名的密钥交换，防止中继跳替换密钥的降级攻击。开启后与未升级的旧节点不建立加密连接；仅在全部节点均已升级的舰队上启用。"
msgstr "全ピアに ID 署名付き鍵交換を必須化し、中継ホップによる鍵すり替えダウングレード攻撃を防ぎます。オンにすると未アップグレードの旧ピアとは暗号リンクを確立しません。全ピアがアップグレード済みのフリートでのみ有効にしてください。"

msgid "访问控制 (ACL)"
msgstr "アクセス制御 (ACL)"

msgid "启用访问控制 (Enable ACL)"
msgstr "ACL を有効化 (Enable ACL)"

msgid "启用后按默认动作 + 规则列表过滤网格流量。默认关闭 (网格完全开放)。"
msgstr "オンにするとメッシュトラフィックを既定アクションとルール一覧でフィルタリングします。既定はオフ（メッシュは完全開放）。"

msgid "默认动作 (Default Action)"
msgstr "既定アクション (Default Action)"

msgid "允许 (Allow)"
msgstr "許可 (Allow)"

msgid "拒绝 (Deny)"
msgstr "拒否 (Deny)"

msgid "详细 ACL 规则"
msgstr "詳細 ACL ルール"

msgid "细粒度规则 (每条的 rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment) 请通过配置文件手动编辑: /etc/config/p2ptap 或生成的 /tmp/etc/p2ptap.json 的 acl.rules 数组。"
msgstr "細かいルール（各 rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment）は設定ファイルで手動編集してください：/etc/config/p2ptap または生成された /tmp/etc/p2ptap.json の acl.rules 配列。"

msgid "抓包采样率 (Pcap Sample Every)"
msgstr "キャプチャサンプル間隔 (Pcap Sample Every)"

msgid "实时抓包视图每 N 帧采样 1 帧。1 = 全量。值越大 CPU 越低但抓包越粗。"
msgstr "ライブキャプチャビューは N フレームごとに 1 フレームをサンプリングします。1 = 全て。値が大きいほど CPU は低くなりますが、キャプチャは粗くなります。"

msgid "抓包速率上限 (Pcap Max Rate, 帧/秒)"
msgstr "キャプチャ最大レート (Pcap Max Rate, フレーム/秒)"

msgid "限制每秒捕获的帧数 (0 = 不限)。作为 PcapSampleEvery 之上的二级安全网。"
msgstr "1 秒あたりのキャプチャフレーム数を制限します（0 = 無制限）。PcapSampleEvery の上の二次安全網です。"
