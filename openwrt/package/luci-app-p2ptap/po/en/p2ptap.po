#: luasrc/controller/p2ptap.lua:8
msgid "p2ptap"
msgstr "p2ptap"

#: luasrc/model/cbi/p2ptap.lua:3
msgid "p2ptap 控制台"
msgstr "p2ptap Console"

#: luasrc/model/cbi/p2ptap.lua:4
msgid "基于 go-libp2p 的二层 P2P TAP 点对点虚拟局域网。支持全功能参数配置、网络传输调优、流量混淆、出口网关模式、一键服务控制及内置 WebUI 管理入口。"
msgstr "A Layer-2 P2P TAP virtual LAN based on go-libp2p. Supports full parameter configuration, transport tuning, traffic obfuscation, exit-gateway mode, one-click service control, and built-in WebUI management."

#: luasrc/model/cbi/p2ptap.lua:9
msgid "运行状态"
msgstr "Running Status"

#: luasrc/model/cbi/p2ptap.lua:11
msgid "服务运行状态"
msgstr "Service Running Status"

#: luasrc/model/cbi/p2ptap.lua:17
msgid "基础与网络配置"
msgstr "Basic & Network Configuration"

#: luasrc/model/cbi/p2ptap.lua:19
msgid "基本配置"
msgstr "Basic Settings"

#: luasrc/model/cbi/p2ptap.lua:20
msgid "虚拟网卡与IP拓扑"
msgstr "Virtual NIC & IP Topology"

#: luasrc/model/cbi/p2ptap.lua:21
msgid "节点与监听配置"
msgstr "Node & Listen Configuration"

#: luasrc/model/cbi/p2ptap.lua:24
msgid "启用 p2ptap 服务"
msgstr "Enable p2ptap Service"

#: luasrc/model/cbi/p2ptap.lua:27
msgid "节点名称 (Node Name)"
msgstr "Node Name"

#: luasrc/model/cbi/p2ptap.lua:30
msgid "网络中标识本路由器的名称，留空默认使用系统 Hostname。"
msgstr "Name to identify this router in the network. Leave empty to use the system hostname."

#: luasrc/model/cbi/p2ptap.lua:32
msgid "日志记录级别 (Log Level)"
msgstr "Log Level"

#: luasrc/model/cbi/p2ptap.lua:33
msgid "调试 (Debug)"
msgstr "Debug"

#: luasrc/model/cbi/p2ptap.lua:34
msgid "信息 (Info)"
msgstr "Info"

#: luasrc/model/cbi/p2ptap.lua:35
msgid "警告 (Warn)"
msgstr "Warn"

#: luasrc/model/cbi/p2ptap.lua:36
msgid "错误 (Error)"
msgstr "Error"

#: luasrc/model/cbi/p2ptap.lua:39
msgid "预共享密钥 (PSK)"
msgstr "Pre-Shared Key (PSK)"

#: luasrc/model/cbi/p2ptap.lua:42
msgid "设置 64 位 Hex 秘钥形成私有隔离加密网络。只与相同 PSK 的节点组网。留空则仅通过 mDNS + Static Peers 发现节点。"
msgstr "A 64-character hex key that forms a private, isolated encrypted network. Only nodes with the same PSK will form a mesh. Leave empty to rely on mDNS + Static Peers for node discovery."

#: luasrc/model/cbi/p2ptap.lua:46
msgid "PSK 必须为 64 位的十六进制(Hex)字符序列！"
msgstr "PSK must be a 64-character hexadecimal (Hex) sequence!"

#: luasrc/model/cbi/p2ptap.lua:52
msgid "身份私钥文件路径 (Node Key File)"
msgstr "Node Key File"

#: luasrc/model/cbi/p2ptap.lua:57
msgid "传输多径策略 (Transport Strategy)"
msgstr "Transport Strategy"

#: luasrc/model/cbi/p2ptap.lua:58
msgid "最优路径 (Best Path - 低延迟自动优选)"
msgstr "Best Path — Low-latency auto-optimal"

#: luasrc/model/cbi/p2ptap.lua:59
msgid "多径双发 (Redundant - 极速双发抗丢包)"
msgstr "Redundant — High-speed dual-send for loss resistance"

#: luasrc/model/cbi/p2ptap.lua:60
msgid "自动退避 (Fallback - 稳定保底)"
msgstr "Fallback — Stable safety net"

#: luasrc/model/cbi/p2ptap.lua:64
msgid "TAP 虚拟网卡名称"
msgstr "TAP Interface Name"

#: luasrc/model/cbi/p2ptap.lua:68
msgid "虚拟 IPv4 地址/掩码 (TAP IPv4 CIDR)"
msgstr "Virtual IPv4 Address / Netmask (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:71
msgid "例如 10.0.0.1/24。同局域网各节点 IP 地址必须在同一网段且保持唯一。"
msgstr "Example: 10.0.0.1/24. All node IPs within the same LAN must be in the same subnet and remain unique."

#: luasrc/model/cbi/p2ptap.lua:73
msgid "虚拟 IPv6 地址/前缀 (TAP IPv6 CIDR)"
msgstr "Virtual IPv6 Address / Prefix (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:75
msgid "例如 fd00::1/64。提供原生二层 IPv6 组网能力。"
msgstr "Example: fd00::1/64. Provides native Layer-2 IPv6 networking."

#: luasrc/model/cbi/p2ptap.lua:79
msgid "IPv6 地址格式错误！必须为带前缀格式 (如 fd00::1/64)"
msgstr "Invalid IPv6 address format! Must include a prefix (e.g. fd00::1/64)"

#: luasrc/model/cbi/p2ptap.lua:85
msgid "TAP 网卡 MAC 地址 (TAP MAC)"
msgstr "TAP MAC Address"

#: luasrc/model/cbi/p2ptap.lua:88
msgid "虚拟网卡的二层 MAC 地址。如留空将自动随机生成并持久化。"
msgstr "Layer-2 MAC address for the virtual interface. Leave empty to auto-generate and persist a random MAC."

#: luasrc/model/cbi/p2ptap.lua:90
msgid "接口最大传输单元 (MTU)"
msgstr "Interface MTU"

#: luasrc/model/cbi/p2ptap.lua:93
msgid "推荐默认 1500 (范围: 68-9000)。"
msgstr "Default 1500 recommended (range: 68–9000)."

#: luasrc/model/cbi/p2ptap.lua:95
msgid "启用 mDNS 局域网节点发现"
msgstr "Enable mDNS LAN Node Discovery"

#: luasrc/model/cbi/p2ptap.lua:97
msgid "本地局域网内自动发现其他 P2P 节点。"
msgstr "Automatically discover other P2P nodes on the local LAN."

#: luasrc/model/cbi/p2ptap.lua:99
msgid "TAP 驱动类型 (Driver Type)"
msgstr "TAP Driver Type"

#: luasrc/model/cbi/p2ptap.lua:100
msgid "自动检测 (Auto)"
msgstr "Auto"

#: luasrc/model/cbi/p2ptap.lua:101
msgid "TAP 驱动 (Linux/macOS)"
msgstr "TAP Driver (Linux/macOS)"

#: luasrc/model/cbi/p2ptap.lua:102
msgid "WinTun 驱动 (Windows)"
msgstr "WinTun Driver (Windows)"

#: luasrc/model/cbi/p2ptap.lua:104
msgid "Windows 系统推荐 wintun，其他系统使用 auto 即可。"
msgstr "Use wintun on Windows; auto is recommended for other systems."

#: luasrc/model/cbi/p2ptap.lua:107
msgid "引导节点列表 (Bootstrap Peers)"
msgstr "Bootstrap Peers"

#: luasrc/model/cbi/p2ptap.lua:109
msgid "公共或私有的 P2P 引导节点 Multiaddr 列表。多行输入，每行一条。"
msgstr "Public or private P2P bootstrap node Multiaddr list, one per line."

#: luasrc/model/cbi/p2ptap.lua:111
msgid "静态直连节点 (Static Peers)"
msgstr "Static Peers"

#: luasrc/model/cbi/p2ptap.lua:113
msgid "手动指定直连对端节点的 Multiaddr。"
msgstr "Manually specify Multiaddr entries for direct peer connections."

#: luasrc/model/cbi/p2ptap.lua:115
msgid "本地 P2P 监听地址 (Listen Multiaddrs)"
msgstr "Listen Multiaddrs"

#: luasrc/model/cbi/p2ptap.lua:117
msgid "本地监听的多地址 Multiaddr 列表。支持 QUIC/WebRTC/WebTransport/TCP。"
msgstr "Local listen Multiaddr list. Supports QUIC/WebRTC/WebTransport/TCP."

#: luasrc/model/cbi/p2ptap.lua:122
msgid "传输协议高级设置"
msgstr "Transport Protocol Advanced Settings"

#: luasrc/model/cbi/p2ptap.lua:125
msgid "启用 QUIC v1 传输协议"
msgstr "Enable QUIC v1 Transport"

#: luasrc/model/cbi/p2ptap.lua:128
msgid "启用 WebRTC Direct 穿透协议"
msgstr "Enable WebRTC Direct NAT Traversal"

#: luasrc/model/cbi/p2ptap.lua:130
msgid "基于浏览器/原生 WebRTC 的 NAT 穿透传输层。"
msgstr "NAT traversal transport layer based on browser/native WebRTC."

#: luasrc/model/cbi/p2ptap.lua:132
msgid "启用 WebTransport 协议"
msgstr "Enable WebTransport"

#: luasrc/model/cbi/p2ptap.lua:134
msgid "基于 HTTP/3 QUIC 的新型传输协议。"
msgstr "New-generation transport protocol based on HTTP/3 QUIC."

#: luasrc/model/cbi/p2ptap.lua:136
msgid "启用 TCP 复用协议"
msgstr "Enable TCP Multiplexing"

#: luasrc/model/cbi/p2ptap.lua:141
msgid "高吞吐场景的激进 TCP 拥塞算法。需内核支持。"
msgstr "Aggressive TCP congestion algorithm for high-throughput scenarios. Requires kernel support."

#: luasrc/model/cbi/p2ptap.lua:151
msgid "流量混淆与数据填充"
msgstr "Traffic Obfuscation & Padding"

#: luasrc/model/cbi/p2ptap.lua:154
msgid "启用二层数据包流量混淆"
msgstr "Enable Layer-2 Packet Obfuscation"

#: luasrc/model/cbi/p2ptap.lua:203
msgid "自动切换阈值 (Auto Threshold Bytes)"
msgstr "Auto Threshold (Bytes)"

#: luasrc/model/cbi/p2ptap.lua:206
msgid "Auto 模式下累计传输超过此字节数后触发重评估。默认 1MB。"
msgstr "In Auto mode, trigger re-evaluation after cumulative transfer exceeds this byte count. Default: 1 MB."

#: luasrc/model/cbi/p2ptap.lua:217
msgid "出口网关 (Exit Node)"
msgstr "Exit Node"

#: luasrc/model/cbi/p2ptap.lua:220
msgid "启用出口网关模式 (Enable Exit Node)"
msgstr "Enable Exit Node"

#: luasrc/model/cbi/p2ptap.lua:222
msgid "启用后本节点允许对端节点通过本机访问外部网络。相当于 P2P VPN 网关。"
msgstr "When enabled, peer nodes can access the external network through this node. Acts as a P2P VPN gateway."

#: luasrc/model/cbi/p2ptap.lua:224
msgid "启用 NAT 伪装 (NAT Masquerade)"
msgstr "Enable NAT Masquerade"

#: luasrc/model/cbi/p2ptap.lua:226
msgid "为转发的出站流量自动添加 SNAT 规则 (iptables MASQUERADE)。"
msgstr "Automatically add SNAT rules (iptables MASQUERADE) for forwarded outbound traffic."

#: luasrc/model/cbi/p2ptap.lua:229
msgid "出口物理网卡 (WAN Interface)"
msgstr "WAN Interface"

#: luasrc/model/cbi/p2ptap.lua:232
msgid "提供外部网络出口的物理网卡名称，如 eth0 / wan / pppoe-wan。填写 'auto' 自动检测默认路由网卡。"
msgstr "Physical interface providing external network access, e.g. eth0 / wan / pppoe-wan. Enter 'auto' to auto-detect the default route interface."

#: luasrc/model/cbi/p2ptap.lua:238
msgid "WebUI 控制台"
msgstr "WebUI Console"

#: luasrc/model/cbi/p2ptap.lua:241
msgid "启用内置 WebUI Dashboard"
msgstr "Enable Built-in WebUI Dashboard"

#: luasrc/model/cbi/p2ptap.lua:244
msgid "WebUI 监听 IPv4 地址"
msgstr "WebUI Listen IPv4 Address"

#: luasrc/model/cbi/p2ptap.lua:247
msgid "WebUI Dashboard 绑定的 IPv4 监听地址，0.0.0.0 表示监听所有接口。"
msgstr "IPv4 listen address for the WebUI Dashboard. Use 0.0.0.0 to listen on all interfaces."

#: luasrc/model/cbi/p2ptap.lua:249
msgid "WebUI 监听 IPv6 地址"
msgstr "WebUI Listen IPv6 Address"

#: luasrc/model/cbi/p2ptap.lua:252
msgid "WebUI Dashboard 绑定的 IPv6 监听地址，:: 表示监听所有接口。"
msgstr "IPv6 listen address for the WebUI Dashboard. Use :: to listen on all interfaces."

#: luasrc/model/cbi/p2ptap.lua:254
msgid "WebUI 监听端口 (Port)"
msgstr "WebUI Listen Port"

#: luasrc/model/cbi/p2ptap.lua:258
msgid "控制台快捷入口"
msgstr "Console Quick Access"

#: luasrc/view/p2ptap/status.htm:7
msgid "运行中 (Running)"
msgstr "Running"

#: luasrc/view/p2ptap/status.htm:9
msgid "未运行 (Stopped)"
msgstr "Stopped"

#: luasrc/view/p2ptap/status.htm:15
msgid "正在获取运行状态..."
msgstr "Fetching running status..."

#: luasrc/model/cbi/p2ptap.lua:22
msgid "内网子网路由 (Site-to-Site)"
msgstr "Subnet Routing (Site-to-Site)"

#: luasrc/model/cbi/p2ptap.lua:24
msgid "流量混淆与加密"
msgstr "Traffic Obfuscation & Encryption"

#: luasrc/model/cbi/p2ptap.lua:55
msgid "自动发现 Boot 骨干集群 (Discover Boot Mesh)"
msgstr "Discover Boot Mesh Clusters"

#: luasrc/model/cbi/p2ptap.lua:57
msgid "自动发现并接入由多个 p2ptap-boot 互联构成的骨干网中继集群，实现跨区域节点全自动互通。"
msgstr "Automatically discover and attach to relay backbones formed by interconnected p2ptap-boot clusters."

#: luasrc/model/cbi/p2ptap.lua:122
msgid "宣告本地内网网段 (Advertised Subnets)"
msgstr "Advertised Local Subnets"

#: luasrc/model/cbi/p2ptap.lua:124
msgid "将当前路由器下挂的局域网网段宣告给 P2P 虚拟网中的对端，使对端设备无需安装客户端即可直接访问本内网主机。"
msgstr "Advertise the local router LAN subnets to the P2P mesh, enabling remote peers to access LAN devices without client software."

#: luasrc/model/cbi/p2ptap.lua:126
msgid "自动接收并接入对端宣告的子网路由"
msgstr "Accept Remote Advertised Subnet Routes"

#: luasrc/model/cbi/p2ptap.lua:128
msgid "启用后，路由器将自动在系统路由表中添加对端节点宣告的内网网段路由，实现 Site-to-Site 双向无缝互通。"
msgstr "When enabled, the router automatically installs kernel routes for subnets advertised by remote peers for bidirectional Site-to-Site connectivity."

#: luasrc/model/cbi/p2ptap.lua:130
msgid "允许接入子网的 Peer ID 白名单"
msgstr "Allowed Subnet Peer IDs Whitelist"

#: luasrc/model/cbi/p2ptap.lua:133
msgid "填写允许向本机推送子网路由的 Peer ID 列表。填写 '*' 表示信任并允许所有合法节点。"
msgstr "List of Peer IDs allowed to advertise subnets to this router. Use '*' to allow all authenticated peers."

#: luasrc/model/cbi/p2ptap.lua:150
msgid "载荷加密算法 (Algorithm)"
msgstr "Payload Encryption Algorithm"

#: luasrc/model/cbi/p2ptap.lua:151
msgid "自动协商 (Auto - 首选 ChaCha20-Poly1305)"
msgstr "Auto Negotiate (Preferred ChaCha20-Poly1305)"

#: luasrc/model/cbi/p2ptap.lua:152
msgid "ChaCha20-Poly1305 (ARM/无 AES 硬件加速路由器推荐)"
msgstr "ChaCha20-Poly1305 (Recommended for ARM / non-AES routers)"

#: luasrc/model/cbi/p2ptap.lua:153
msgid "AES-128-GCM (x86_64 / 带 AES-NI 路由器推荐)"
msgstr "AES-128-GCM (Recommended for x86_64 / AES-NI routers)"

#: luasrc/model/cbi/p2ptap.lua:154
msgid "明文 (None - 关闭加密，仅保留帧混淆)"
msgstr "Plaintext (None - Disable encryption, retain frame padding)"

#: luasrc/model/cbi/p2ptap.lua:237
msgid "WebUI 访问 Token / 密码"
msgstr "WebUI Auth Token / Password"

#: luasrc/model/cbi/p2ptap.lua:240
msgid "访问 WebUI 面板所需的认证密钥。如留空，程序启动时将在日志中打印生成的临时 Token。"
msgstr "Bearer token for WebUI access. If empty, a random token is generated and logged at startup."

#: luasrc/view/p2ptap/status.htm
msgid "自身 Peer ID (Local Peer ID)"
msgstr "Local Peer ID"

msgid "虚拟 IPv4 (TAP IPv4)"
msgstr "TAP IPv4 Address"

msgid "虚拟 IPv6 (TAP IPv6)"
msgstr "TAP IPv6 Address"

msgid "虚拟 MAC (TAP MAC)"
msgstr "TAP MAC Address"

msgid "实时网速 (Speed)"
msgstr "Traffic Speed"

msgid "个 Peer 在线"
msgstr "Peers Online"

msgid "当前出口网关"
msgstr "Active Default Gateway"

msgid "打开完整 WebUI 控制台 (拓扑图/实时监控)"
msgstr "Open Full WebUI Dashboard (Topology / Live Monitor)"

msgid "Peer ID 已复制到剪贴板！"
msgstr "Peer ID copied to clipboard!"

msgid "多径调度 (Multipath - 跨路径重排/抗丢包)"
msgstr "Multipath Scheduling (reordering/anti-loss across paths)"

msgid "multipath 下接收端开启重排缓冲，可结合 rx_reorder_window / rx_reorder_delay_ms 调优。"
msgstr "Under multipath, the receiver enables a reorder buffer, tunable via rx_reorder_window / rx_reorder_delay_ms."

msgid "统计采样率 (Stats Sample Every)"
msgstr "Stats Sample Every"

msgid "每 N 帧记录一次报文分类统计。1 = 全量记录 (默认)。高吞吐部署可提升至 16-64 降低 CPU。字节/包速率统计始终精确。"
msgstr "Record packet-classification stats every N frames. 1 = record all (default). High-throughput deployments can raise to 16-64 to lower CPU. Byte/packet rate stats are always exact."

msgid "强制私有可达性 (Force Private Reachability)"
msgstr "Force Private Reachability"

msgid "强制 libp2p 主机宣告为私有 (仅中继可达)。默认关闭: 通过 AutoNAT 自动检测，公网节点仍宣告直连地址。仅当 AutoNAT 在您的网络中不可靠时启用。"
msgstr "Force the libp2p host to advertise as private (relay-only). Default off: reachability is auto-detected via AutoNAT, so public nodes still advertise direct addresses. Enable only when AutoNAT is unreliable in your network."

msgid "启用 WebRTC 信令穿透 (WebRTC Signaling)"
msgstr "Enable WebRTC Signaling Hole-Punching"

msgid "中继专用对端无法直连时，通过控制通道交换真实 SDP 并运行完整 ICE (STUN/TURN)，可穿越一层或两层 NAT。独立于 webrtc-direct (LITE 无法穿 NAT)。需重启生效。"
msgstr "When a relay-only peer cannot be reached directly, exchange real SDP over the control channel and run a full ICE agent (STUN/TURN) to traverse one or two NATs. Separate from webrtc-direct (LITE cannot cross NAT). Requires restart."

msgid "TLS SNI 服务器名 (TLS Server Name)"
msgstr "TLS SNI Server Name"

msgid "留空表示不发送 SNI"
msgstr "Leave empty to send no SNI"

msgid "出站握手 (TLS-over-TCP 与 QUIC) 的 server_name (SNI)。设置后使网格流量更接近普通 HTTP/3。不影响认证。"
msgstr "The server_name (SNI) on outgoing handshakes (TLS-over-TCP and QUIC). Setting it makes mesh traffic resemble ordinary HTTP/3. Does not affect authentication."

msgid "按 Peer 派生 SNI 后缀 (TLS SNI Suffix)"
msgstr "Per-Peer Derived SNI Suffix (TLS SNI Suffix)"

msgid "例如 vpn.example.com"
msgstr "e.g. vpn.example.com"

msgid "出站 SNI 变为 '<peer 标签>.<后缀>'，使每个链路呈现稳定且不同的 SNI，避免所有节点发送相同 SNI 的全局关联特征。优先于 tls_server_name。需重启生效。"
msgstr "The outgoing SNI becomes '<peer label>.<suffix>', giving every link a distinct, stable SNI and avoiding the global-correlation tell of all nodes sending the same SNI. Takes precedence over tls_server_name. Requires restart."

msgid "禁用 Circuit Relay 标准中继"
msgstr "Disable Circuit Relay"

msgid "仅关闭 libp2p circuit-relay 与 AutoRelay，保留 DCUtR 打洞。"
msgstr "Turn off only libp2p circuit-relay and AutoRelay, keeping DCUtR hole-punching on."

msgid "禁用 DCUtR 打洞"
msgstr "Disable DCUtR Hole-Punching"

msgid "仅关闭 DCUtR 打洞，保留 Circuit Relay 与 AutoRelay。"
msgstr "Turn off only DCUtR hole-punching, keeping Circuit Relay and AutoRelay on."

msgid "禁用全部中继与打洞 (诊断)"
msgstr "Disable All Relaying and Hole-Punching (Diagnostic)"

msgid "一次性关闭 Circuit Relay + AutoRelay + DCUtR，仅依赖直连或 p2ptap 专有骨干中继。不影响 p2ptap 自身 overlay 中继。"
msgstr "Turn off Circuit Relay + AutoRelay + DCUtR in one go, relying only on direct connections or p2ptap's own backbone relay. Does not affect p2ptap's overlay relay."

msgid "overlay 中继帧使用 multihash 头"
msgstr "Use Multihash Header for Overlay Relay Frames"

msgid "以紧凑 0x03 头发送 p2ptap overlay 中继帧 (Peer ID 用原始 multihash 而非 base58 CID)。默认关闭: 仅当整个传输路径上所有 overlay 中继与 boot 中继都已升级时启用，否则中间 v2 节点会丢弃帧。读取端始终兼容两种头。"
msgstr "Send p2ptap overlay relay frames with the compact 0x03 header (Peer IDs as raw multihash bytes instead of base58 CID). Off by default: enable only when every overlay relay and boot relay on the transit path is upgraded, or intermediate v2 nodes drop the frame. Readers always accept both headers."

msgid "STUN 服务器 (WebRTC ICE)"
msgstr "STUN Servers (WebRTC ICE)"

msgid "WebRTC ICE 候选收集的 STUN 服务器 Multiaddr。提供 server-reflexive 候选，显著提升 WebRTC 打洞成功率。留空则仅依赖 host 候选。"
msgstr "STUN server multiaddrs for WebRTC ICE candidate gathering. Provide server-reflexive candidates, significantly improving WebRTC hole-punching success. Leave empty to rely on host candidates only."

msgid "TURN 服务器 (WebRTC 中继回退)"
msgstr "TURN Servers (WebRTC Relay Fallback)"

msgid "TURN 中继回退 URL。必须携带凭据，否则 WebRTC 会整体中止。留空为正确默认: 走 STUN + 打洞，TURN 仅作回退。"
msgstr "TURN relay fallback URLs. Credentials are required, otherwise WebRTC aborts entirely. Leave empty for the correct default: STUN + hole punching, TURN only as fallback."

msgid "接收端重排缓冲 (Rx Reorder Window)"
msgstr "Rx Reorder Window"

msgid "multipath 策略下的接收端重排缓冲帧数上限。匹配去重容忍度 (1024)。"
msgstr "Max frames in the receive-side reorder buffer under the multipath strategy. Matches the dedup tolerance (1024)."

msgid "重排队头超时 (Rx Reorder Delay, ms)"
msgstr "Rx Reorder Delay (ms)"

msgid "multipath 下队头阻塞的强制释放超时毫秒数。默认 300ms 覆盖 LAN+WAN 直连路径的延迟差；混合 RTT 差更大的路径可调高。"
msgstr "Head-of-line force-release timeout (ms) under multipath. Default 300ms covers the latency spread of a LAN+WAN direct path pair; raise it for paths with larger RTT differences."

msgid "填充规则 (Padding Rules)"
msgstr "Padding Rules"

msgid "每行一条填充带规则，语法: '<floor> -> <target_min>[-<target_max>]'。可选一行 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' 控制包聚合。留空使用默认规则 '0 -> 400-600' (小于 400 字节填充到 400-600 随机长度，400 以上原样发送，并启用聚合)。带区间按 floor 升序。"
msgstr "One padding band per line, syntax: '<floor> -> <target_min>[-<target_max>]'. An optional 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' line controls packet coalescing. Leave empty for the default rule '0 -> 400-600' (payloads under 400 bytes pad to a random 400-600, 400+ sent naturally, with coalescing on). Bands are ordered by floor ascending."

msgid "分片上限 (Max Frag Size)"
msgstr "Max Frag Size"

msgid "TAP 帧分片层的单分片内层大小上限 (字节)。0 = 由节点根据 MTU 与混淆开销自动推导。范围 256-1400。"
msgstr "Cap on the per-fragment inner size (bytes) of the TAP-frame fragmentation layer. 0 = auto-derived by the node from MTU and obfuscation overhead. Range 256-1400."

msgid "严格密钥协商 (Strict Key Negotiation)"
msgstr "Strict Key Negotiation"

msgid "强制每对 Peer 用一次性 ECDH(P256) 临时密钥派生独立密钥 (前向保密)。关闭则允许在重同步时退回到长寿命节点密钥。"
msgstr "Force each peer pair to derive its own cipher from a one-shot ECDH(P256) ephemeral key (forward secrecy). Off allows falling back to the long-lived node key on a re-sync."

msgid "强制认证密钥交换 (Require Auth Key Exchange)"
msgstr "Require Auth Key Exchange"

msgid "对每个 Peer 强制身份签名的密钥交换，防止中继跳替换密钥的降级攻击。开启后与未升级的旧节点不建立加密连接；仅在全部节点均已升级的舰队上启用。"
msgstr "Require an identity-signed key exchange from every peer, preventing a transit relay hop from substituting its own key. When on, encrypted links are not established with un-upgraded legacy peers; enable only on fleets where every peer is upgraded."

msgid "访问控制 (ACL)"
msgstr "Access Control (ACL)"

msgid "启用访问控制 (Enable ACL)"
msgstr "Enable ACL"

msgid "启用后按默认动作 + 规则列表过滤网格流量。默认关闭 (网格完全开放)。"
msgstr "When on, mesh traffic is filtered by the default action plus the rules list. Off by default (mesh fully open)."

msgid "默认动作 (Default Action)"
msgstr "Default Action"

msgid "允许 (Allow)"
msgstr "Allow"

msgid "拒绝 (Deny)"
msgstr "Deny"

msgid "详细 ACL 规则"
msgstr "Detailed ACL Rules"

msgid "细粒度规则 (每条的 rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment) 请通过配置文件手动编辑: /etc/config/p2ptap 或生成的 /tmp/etc/p2ptap.json 的 acl.rules 数组。"
msgstr "Fine-grained rules (per-rule rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment) must be edited manually in the config file: the acl.rules array in /etc/config/p2ptap or the generated /tmp/etc/p2ptap.json."

msgid "抓包采样率 (Pcap Sample Every)"
msgstr "Pcap Sample Every"

msgid "实时抓包视图每 N 帧采样 1 帧。1 = 全量。值越大 CPU 越低但抓包越粗。"
msgstr "The live packet view samples 1 of every N frames. 1 = all. Higher = lower CPU but coarser capture."

msgid "抓包速率上限 (Pcap Max Rate, 帧/秒)"
msgstr "Pcap Max Rate (frames/sec)"

msgid "限制每秒捕获的帧数 (0 = 不限)。作为 PcapSampleEvery 之上的二级安全网。"
msgstr "Caps captured frames per second (0 = unlimited). A secondary safety net on top of PcapSampleEvery."
