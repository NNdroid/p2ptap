#: luasrc/controller/p2ptap.lua:8
msgid "p2ptap"
msgstr "p2ptap"

#: luasrc/model/cbi/p2ptap.lua:3
msgid "p2ptap 控制台"
msgstr "Console p2ptap"

#: luasrc/model/cbi/p2ptap.lua:4
msgid "基于 go-libp2p 的二层 P2P TAP 点对点虚拟局域网。支持全功能参数配置、网络传输调优、流量混淆、出口网关模式、一键服务控制及内置 WebUI 管理入口。"
msgstr "Un réseau LAN virtuel P2P TAP de niveau 2 basé sur go-libp2p. Prend en charge la configuration complète des paramètres, l'optimisation du transport, l'obscurcissement du trafic, le mode passerelle de sortie, le contrôle de service en un clic et la gestion via WebUI intégrée."

#: luasrc/model/cbi/p2ptap.lua:9
msgid "运行状态"
msgstr "État de fonctionnement"

#: luasrc/model/cbi/p2ptap.lua:11
msgid "服务运行状态"
msgstr "État du service"

#: luasrc/model/cbi/p2ptap.lua:17
msgid "基础与网络配置"
msgstr "Configuration de base et réseau"

#: luasrc/model/cbi/p2ptap.lua:19
msgid "基本配置"
msgstr "Paramètres de base"

#: luasrc/model/cbi/p2ptap.lua:20
msgid "虚拟网卡与IP拓扑"
msgstr "Interface virtuelle et topologie IP"

#: luasrc/model/cbi/p2ptap.lua:21
msgid "节点与监听配置"
msgstr "Configuration des nœuds et de l'écoute"

#: luasrc/model/cbi/p2ptap.lua:24
msgid "启用 p2ptap 服务"
msgstr "Activer le service p2ptap"

#: luasrc/model/cbi/p2ptap.lua:27
msgid "节点名称 (Node Name)"
msgstr "Nom du nœud (Node Name)"

#: luasrc/model/cbi/p2ptap.lua:30
msgid "网络中标识本路由器的名称，留空默认使用系统 Hostname。"
msgstr "Nom identifiant ce routeur dans le réseau. Laissez vide pour utiliser le nom d'hôte du système."

#: luasrc/model/cbi/p2ptap.lua:32
msgid "日志记录级别 (Log Level)"
msgstr "Niveau de journalisation (Log Level)"

#: luasrc/model/cbi/p2ptap.lua:33
msgid "调试 (Debug)"
msgstr "Débogage (Debug)"

#: luasrc/model/cbi/p2ptap.lua:34
msgid "信息 (Info)"
msgstr "Information (Info)"

#: luasrc/model/cbi/p2ptap.lua:35
msgid "警告 (Warn)"
msgstr "Avertissement (Warn)"

#: luasrc/model/cbi/p2ptap.lua:36
msgid "错误 (Error)"
msgstr "Erreur (Error)"

#: luasrc/model/cbi/p2ptap.lua:39
msgid "预共享密钥 (PSK)"
msgstr "Clé pré-partagée (PSK)"

#: luasrc/model/cbi/p2ptap.lua:42
msgid "设置 64 位 Hex 秘钥形成私有隔离加密网络。只与相同 PSK 的节点组网。留空则仅通过 mDNS + Static Peers 发现节点。"
msgstr "Une clé hexadécimale de 64 caractères formant un réseau chiffré privé et isolé. Seuls les nœuds avec la même PSK formeront un maillage. Laissez vide pour découvrir les nœuds via mDNS + Static Peers."

#: luasrc/model/cbi/p2ptap.lua:46
msgid "PSK 必须为 64 位的十六进制(Hex)字符序列！"
msgstr "La PSK doit être une séquence hexadécimale de 64 caractères !"

#: luasrc/model/cbi/p2ptap.lua:52
msgid "身份私钥文件路径 (Node Key File)"
msgstr "Fichier de clé de nœud (Node Key File)"

#: luasrc/model/cbi/p2ptap.lua:57
msgid "传输多径策略 (Transport Strategy)"
msgstr "Stratégie de transport (Transport Strategy)"

#: luasrc/model/cbi/p2ptap.lua:58
msgid "最优路径 (Best Path - 低延迟自动优选)"
msgstr "Meilleur chemin — Sélection automatique à faible latence"

#: luasrc/model/cbi/p2ptap.lua:59
msgid "多径双发 (Redundant - 极速双发抗丢包)"
msgstr "Redondant — Double envoi haute vitesse anti-perte"

#: luasrc/model/cbi/p2ptap.lua:60
msgid "自动退避 (Fallback - 稳定保底)"
msgstr "Fallback — Filet de sécurité stable"

#: luasrc/model/cbi/p2ptap.lua:64
msgid "TAP 虚拟网卡名称"
msgstr "Nom de l'interface TAP"

#: luasrc/model/cbi/p2ptap.lua:68
msgid "虚拟 IPv4 地址/掩码 (TAP IPv4 CIDR)"
msgstr "Adresse IPv4 virtuelle / Masque (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:71
msgid "例如 10.0.0.1/24。同局域网各节点 IP 地址必须在同一网段且保持唯一。"
msgstr "Exemple : 10.0.0.1/24. Toutes les adresses IP des nœuds du même LAN doivent être dans le même sous-réseau et rester uniques."

#: luasrc/model/cbi/p2ptap.lua:73
msgid "虚拟 IPv6 地址/前缀 (TAP IPv6 CIDR)"
msgstr "Adresse IPv6 virtuelle / Préfixe (CIDR)"

#: luasrc/model/cbi/p2ptap.lua:75
msgid "例如 fd00::1/64。提供原生二层 IPv6 组网能力。"
msgstr "Exemple : fd00::1/64. Fournit une capacité réseau IPv6 native de niveau 2."

#: luasrc/model/cbi/p2ptap.lua:79
msgid "IPv6 地址格式错误！必须为带前缀格式 (如 fd00::1/64)"
msgstr "Format d'adresse IPv6 invalide ! Doit inclure un préfixe (ex. fd00::1/64)"

#: luasrc/model/cbi/p2ptap.lua:85
msgid "TAP 网卡 MAC 地址 (TAP MAC)"
msgstr "Adresse MAC TAP"

#: luasrc/model/cbi/p2ptap.lua:88
msgid "虚拟网卡的二层 MAC 地址。如留空将自动随机生成并持久化。"
msgstr "Adresse MAC de niveau 2 pour l'interface virtuelle. Laissez vide pour générer et persister automatiquement une MAC aléatoire."

#: luasrc/model/cbi/p2ptap.lua:90
msgid "接口最大传输单元 (MTU)"
msgstr "MTU de l'interface"

#: luasrc/model/cbi/p2ptap.lua:93
msgid "推荐默认 1500 (范围: 68-9000)。"
msgstr "Valeur par défaut recommandée : 1500 (plage : 68–9000)."

#: luasrc/model/cbi/p2ptap.lua:95
msgid "启用 mDNS 局域网节点发现"
msgstr "Activer la découverte de nœuds LAN via mDNS"

#: luasrc/model/cbi/p2ptap.lua:97
msgid "本地局域网内自动发现其他 P2P 节点。"
msgstr "Découvrir automatiquement les autres nœuds P2P sur le LAN local."

#: luasrc/model/cbi/p2ptap.lua:99
msgid "TAP 驱动类型 (Driver Type)"
msgstr "Type de pilote TAP (Driver Type)"

#: luasrc/model/cbi/p2ptap.lua:100
msgid "自动检测 (Auto)"
msgstr "Auto"

#: luasrc/model/cbi/p2ptap.lua:101
msgid "TAP 驱动 (Linux/macOS)"
msgstr "Pilote TAP (Linux/macOS)"

#: luasrc/model/cbi/p2ptap.lua:102
msgid "WinTun 驱动 (Windows)"
msgstr "Pilote WinTun (Windows)"

#: luasrc/model/cbi/p2ptap.lua:104
msgid "Windows 系统推荐 wintun，其他系统使用 auto 即可。"
msgstr "Utilisez wintun sur Windows ; auto est recommandé pour les autres systèmes."

#: luasrc/model/cbi/p2ptap.lua:107
msgid "引导节点列表 (Bootstrap Peers)"
msgstr "Paires d'amorçage (Bootstrap Peers)"

#: luasrc/model/cbi/p2ptap.lua:109
msgid "公共或私有的 P2P 引导节点 Multiaddr 列表。多行输入，每行一条。"
msgstr "Liste de Multiaddr des nœuds d'amorçage P2P publics ou privés, une par ligne."

#: luasrc/model/cbi/p2ptap.lua:111
msgid "静态直连节点 (Static Peers)"
msgstr "Paires statiques (Static Peers)"

#: luasrc/model/cbi/p2ptap.lua:113
msgid "手动指定直连对端节点的 Multiaddr。"
msgstr "Spécifiez manuellement les Multiaddr pour les connexions directes aux pairs."

#: luasrc/model/cbi/p2ptap.lua:115
msgid "本地 P2P 监听地址 (Listen Multiaddrs)"
msgstr "Multiaddrs d'écoute (Listen Multiaddrs)"

#: luasrc/model/cbi/p2ptap.lua:117
msgid "本地监听的多地址 Multiaddr 列表。支持 QUIC/WebRTC/WebTransport/TCP。"
msgstr "Liste de Multiaddr d'écoute locale. Prend en charge QUIC/WebRTC/WebTransport/TCP."

#: luasrc/model/cbi/p2ptap.lua:122
msgid "传输协议高级设置"
msgstr "Paramètres avancés du protocole de transport"

#: luasrc/model/cbi/p2ptap.lua:125
msgid "启用 QUIC v1 传输协议"
msgstr "Activer le transport QUIC v1"

#: luasrc/model/cbi/p2ptap.lua:128
msgid "启用 WebRTC Direct 穿透协议"
msgstr "Activer la traversée NAT WebRTC Direct"

#: luasrc/model/cbi/p2ptap.lua:130
msgid "基于浏览器/原生 WebRTC 的 NAT 穿透传输层。"
msgstr "Couche de transport avec traversée NAT basée sur WebRTC navigateur/natif."

#: luasrc/model/cbi/p2ptap.lua:132
msgid "启用 WebTransport 协议"
msgstr "Activer WebTransport"

#: luasrc/model/cbi/p2ptap.lua:134
msgid "基于 HTTP/3 QUIC 的新型传输协议。"
msgstr "Protocole de transport nouvelle génération basé sur HTTP/3 QUIC."

#: luasrc/model/cbi/p2ptap.lua:136
msgid "启用 TCP 复用协议"
msgstr "Activer le multiplexage TCP"

#: luasrc/model/cbi/p2ptap.lua:141
msgid "高吞吐场景的激进 TCP 拥塞算法。需内核支持。"
msgstr "Algorithme de congestion TCP agressif pour les scénarios à haut débit. Nécessite le support du noyau."

#: luasrc/model/cbi/p2ptap.lua:151
msgid "流量混淆与数据填充"
msgstr "Obscurcissement du trafic et remplissage"

#: luasrc/model/cbi/p2ptap.lua:154
msgid "启用二层数据包流量混淆"
msgstr "Activer l'obscurcissement des paquets de niveau 2"

#: luasrc/model/cbi/p2ptap.lua:203
msgid "自动切换阈值 (Auto Threshold Bytes)"
msgstr "Seuil automatique (octets)"

#: luasrc/model/cbi/p2ptap.lua:206
msgid "Auto 模式下累计传输超过此字节数后触发重评估。默认 1MB。"
msgstr "En mode Auto, déclenche la réévaluation après que le transfert cumulé dépasse ce nombre d'octets. Par défaut : 1 Mo."

#: luasrc/model/cbi/p2ptap.lua:217
msgid "出口网关 (Exit Node)"
msgstr "Nœud de sortie (Exit Node)"

#: luasrc/model/cbi/p2ptap.lua:220
msgid "启用出口网关模式 (Enable Exit Node)"
msgstr "Activer le nœud de sortie"

#: luasrc/model/cbi/p2ptap.lua:222
msgid "启用后本节点允许对端节点通过本机访问外部网络。相当于 P2P VPN 网关。"
msgstr "Lorsqu'activé, les nœuds pairs peuvent accéder au réseau externe via ce nœud. Agit comme une passerelle VPN P2P."

#: luasrc/model/cbi/p2ptap.lua:224
msgid "启用 NAT 伪装 (NAT Masquerade)"
msgstr "Activer le masquerade NAT"

#: luasrc/model/cbi/p2ptap.lua:226
msgid "为转发的出站流量自动添加 SNAT 规则 (iptables MASQUERADE)。"
msgstr "Ajouter automatiquement des règles SNAT (iptables MASQUERADE) pour le trafic sortant transféré."

#: luasrc/model/cbi/p2ptap.lua:229
msgid "出口物理网卡 (WAN Interface)"
msgstr "Interface WAN (WAN Interface)"

#: luasrc/model/cbi/p2ptap.lua:232
msgid "提供外部网络出口的物理网卡名称，如 eth0 / wan / pppoe-wan。填写 'auto' 自动检测默认路由网卡。"
msgstr "Interface physique fournissant l'accès au réseau externe, ex. eth0 / wan / pppoe-wan. Entrez 'auto' pour détecter automatiquement l'interface de route par défaut."

#: luasrc/model/cbi/p2ptap.lua:238
msgid "WebUI 控制台"
msgstr "Console WebUI"

#: luasrc/model/cbi/p2ptap.lua:241
msgid "启用内置 WebUI Dashboard"
msgstr "Activer le tableau de bord WebUI intégré"

#: luasrc/model/cbi/p2ptap.lua:244
msgid "WebUI 监听 IPv4 地址"
msgstr "Adresse IPv4 d'écoute WebUI"

#: luasrc/model/cbi/p2ptap.lua:247
msgid "WebUI Dashboard 绑定的 IPv4 监听地址，0.0.0.0 表示监听所有接口。"
msgstr "Adresse IPv4 d'écoute pour le tableau de bord WebUI. Utilisez 0.0.0.0 pour écouter sur toutes les interfaces."

#: luasrc/model/cbi/p2ptap.lua:249
msgid "WebUI 监听 IPv6 地址"
msgstr "Adresse IPv6 d'écoute WebUI"

#: luasrc/model/cbi/p2ptap.lua:252
msgid "WebUI Dashboard 绑定的 IPv6 监听地址，:: 表示监听所有接口。"
msgstr "Adresse IPv6 d'écoute pour le tableau de bord WebUI. Utilisez :: pour écouter sur toutes les interfaces."

#: luasrc/model/cbi/p2ptap.lua:254
msgid "WebUI 监听端口 (Port)"
msgstr "Port d'écoute WebUI (Port)"

#: luasrc/model/cbi/p2ptap.lua:258
msgid "控制台快捷入口"
msgstr "Accès rapide à la console"

#: luasrc/view/p2ptap/status.htm:7
msgid "运行中 (Running)"
msgstr "En cours d'exécution"

#: luasrc/view/p2ptap/status.htm:9
msgid "未运行 (Stopped)"
msgstr "Arrêté"

#: luasrc/view/p2ptap/status.htm:15
msgid "正在获取运行状态..."
msgstr "Récupération de l'état de fonctionnement..."


msgid "多径调度 (Multipath - 跨路径重排/抗丢包)"
msgstr "Ordonnancement multipath (réordonnancement/anti-perte entre chemins)"

msgid "multipath 下接收端开启重排缓冲，可结合 rx_reorder_window / rx_reorder_delay_ms 调优。"
msgstr "En mode multipath, le récepteur active une mémoire tampon de réordonnancement, réglable via rx_reorder_window / rx_reorder_delay_ms."

msgid "统计采样率 (Stats Sample Every)"
msgstr "Échantillonnage des statistiques (Stats Sample Every)"

msgid "每 N 帧记录一次报文分类统计。1 = 全量记录 (默认)。高吞吐部署可提升至 16-64 降低 CPU。字节/包速率统计始终精确。"
msgstr "Enregistrer les statistiques de classification de paquets toutes les N trames. 1 = tout enregistrer (défaut). Les déploiements à haut débit peuvent monter à 16-64 pour réduire le CPU. Les statistiques de débit octets/paquets sont toujours exactes."

msgid "强制私有可达性 (Force Private Reachability)"
msgstr "Forcer la visibilité privée (Force Private Reachability)"

msgid "强制 libp2p 主机宣告为私有 (仅中继可达)。默认关闭: 通过 AutoNAT 自动检测，公网节点仍宣告直连地址。仅当 AutoNAT 在您的网络中不可靠时启用。"
msgstr "Forcer l'hôte libp2p à s'annoncer privé (relais uniquement). Désactivé par défaut : la visibilité est auto-détectée via AutoNAT, les nœuds publics annoncent donc toujours leurs adresses directes. Activer uniquement si AutoNAT est peu fiable sur votre réseau."

msgid "启用 WebRTC 信令穿透 (WebRTC Signaling)"
msgstr "Activer la traversée par signalisation WebRTC (WebRTC Signaling)"

msgid "中继专用对端无法直连时，通过控制通道交换真实 SDP 并运行完整 ICE (STUN/TURN)，可穿越一层或两层 NAT。独立于 webrtc-direct (LITE 无法穿 NAT)。需重启生效。"
msgstr "Lorsqu'un pair relais uniquement n'est pas joignable directement, échanger un vrai SDP via le canal de contrôle et exécuter un agent ICE complet (STUN/TURN) pour traverser un ou deux NAT. Distinct de webrtc-direct (LITE ne traverse pas le NAT). Nécessite un redémarrage."

msgid "TLS SNI 服务器名 (TLS Server Name)"
msgstr "Nom de serveur TLS SNI (TLS Server Name)"

msgid "留空表示不发送 SNI"
msgstr "Laisser vide pour ne pas envoyer de SNI"

msgid "出站握手 (TLS-over-TCP 与 QUIC) 的 server_name (SNI)。设置后使网格流量更接近普通 HTTP/3。不影响认证。"
msgstr "Le server_name (SNI) des poignées de main sortantes (TLS-over-TCP et QUIC). Le définir rend le trafic maillé semblable à du HTTP/3 ordinaire. N'affecte pas l'authentification."

msgid "按 Peer 派生 SNI 后缀 (TLS SNI Suffix)"
msgstr "Suffixe SNI dérivé par pair (TLS SNI Suffix)"

msgid "例如 vpn.example.com"
msgstr "ex. vpn.example.com"

msgid "出站 SNI 变为 '<peer 标签>.<后缀>'，使每个链路呈现稳定且不同的 SNI，避免所有节点发送相同 SNI 的全局关联特征。优先于 tls_server_name。需重启生效。"
msgstr "Le SNI sortant devient '<étiquette pair>.<suffixe>', offrant à chaque lien un SNI distinct et stable, évitant l'indice de corrélation globale de tous les nœuds envoyant le même SNI. Prioritaire sur tls_server_name. Nécessite un redémarrage."

msgid "禁用 Circuit Relay 标准中继"
msgstr "Désactiver Circuit Relay"

msgid "仅关闭 libp2p circuit-relay 与 AutoRelay，保留 DCUtR 打洞。"
msgstr "Désactiver uniquement circuit-relay et AutoRelay de libp2p, en conservant la traversée DCUtR."

msgid "禁用 DCUtR 打洞"
msgstr "Désactiver la traversée DCUtR"

msgid "仅关闭 DCUtR 打洞，保留 Circuit Relay 与 AutoRelay。"
msgstr "Désactiver uniquement la traversée DCUtR, en conservant Circuit Relay et AutoRelay."

msgid "禁用全部中继与打洞 (诊断)"
msgstr "Désactiver tout le relais et la traversée (Diagnostic)"

msgid "一次性关闭 Circuit Relay + AutoRelay + DCUtR，仅依赖直连或 p2ptap 专有骨干中继。不影响 p2ptap 自身 overlay 中继。"
msgstr "Désactiver d'un coup Circuit Relay + AutoRelay + DCUtR, en s'appuyant uniquement sur les connexions directes ou le relais dorsal p2ptap. N'affecte pas le relais overlay p2ptap."

msgid "overlay 中继帧使用 multihash 头"
msgstr "Utiliser l'en-tête multihash pour les trames de relais overlay"

msgid "以紧凑 0x03 头发送 p2ptap overlay 中继帧 (Peer ID 用原始 multihash 而非 base58 CID)。默认关闭: 仅当整个传输路径上所有 overlay 中继与 boot 中继都已升级时启用，否则中间 v2 节点会丢弃帧。读取端始终兼容两种头。"
msgstr "Envoyer les trames de relais overlay p2ptap avec l'en-tête compact 0x03 (Peer IDs en octets multihash bruts au lieu de CID base58). Désactivé par défaut : activer uniquement lorsque tous les relais overlay et boot du chemin sont mis à niveau, sinon les nœuds v2 intermédiaires suppriment la trame. Les lecteurs acceptent toujours les deux en-têtes."

msgid "STUN 服务器 (WebRTC ICE)"
msgstr "Serveurs STUN (ICE WebRTC)"

msgid "WebRTC ICE 候选收集的 STUN 服务器 Multiaddr。提供 server-reflexive 候选，显著提升 WebRTC 打洞成功率。留空则仅依赖 host 候选。"
msgstr "Multiadresses de serveurs STUN pour la collecte de candidats ICE WebRTC. Fournissent des candidats server-reflexive, améliorant nettement le succès de la traversée WebRTC. Laisser vide pour ne dépendre que des candidats host."

msgid "TURN 服务器 (WebRTC 中继回退)"
msgstr "Serveurs TURN (repli relais WebRTC)"

msgid "TURN 中继回退 URL。必须携带凭据，否则 WebRTC 会整体中止。留空为正确默认: 走 STUN + 打洞，TURN 仅作回退。"
msgstr "URLs de repli relais TURN. Les identifiants sont obligatoires, sinon WebRTC s'interrompt entièrement. Laisser vide pour le défaut correct : STUN + traversée, TURN uniquement en repli."

msgid "接收端重排缓冲 (Rx Reorder Window)"
msgstr "Fenêtre de réordonnancement Rx (Rx Reorder Window)"

msgid "multipath 策略下的接收端重排缓冲帧数上限。匹配去重容忍度 (1024)。"
msgstr "Nombre maximal de trames dans la mémoire tampon de réordonnancement côté réception en mode multipath. Correspond à la tolérance de déduplication (1024)."

msgid "重排队头超时 (Rx Reorder Delay, ms)"
msgstr "Délai de réordonnancement Rx (ms)"

msgid "multipath 下队头阻塞的强制释放超时毫秒数。默认 300ms 覆盖 LAN+WAN 直连路径的延迟差；混合 RTT 差更大的路径可调高。"
msgstr "Délai de libération forcée du blocage de tête (ms) en multipath. 300ms par défaut couvre l'étalement de latence d'une paire de chemins directs LAN+WAN ; augmenter pour des chemins avec de plus grandes différences de RTT."

msgid "填充规则 (Padding Rules)"
msgstr "Règles de remplissage (Padding Rules)"

msgid "每行一条填充带规则，语法: '<floor> -> <target_min>[-<target_max>]'。可选一行 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' 控制包聚合。留空使用默认规则 '0 -> 400-600' (小于 400 字节填充到 400-600 随机长度，400 以上原样发送，并启用聚合)。带区间按 floor 升序。"
msgstr "Une bande de remplissage par ligne, syntaxe : '<floor> -> <target_min>[-<target_max>]'. Une ligne facultative 'coalesce on|off [max_delay_ms=N] [max_bytes=N] [max_frames=N]' contrôle la coalescence des paquets. Laisser vide pour la règle par défaut '0 -> 400-600' (les charges utiles < 400 octets sont remplies à 400-600 aléatoire, 400+ envoyées telles quelles, coalescence activée). Les bandes sont triées par floor croissant."

msgid "分片上限 (Max Frag Size)"
msgstr "Taille max de fragment (Max Frag Size)"

msgid "TAP 帧分片层的单分片内层大小上限 (字节)。0 = 由节点根据 MTU 与混淆开销自动推导。范围 256-1400。"
msgstr "Plafond de la taille interne par fragment (octets) de la couche de fragmentation des trames TAP. 0 = dérivée automatiquement par le nœud depuis le MTU et le surcoût d'obscurcissement. Plage 256-1400."

msgid "严格密钥协商 (Strict Key Negotiation)"
msgstr "Négociation de clé stricte (Strict Key Negotiation)"

msgid "强制每对 Peer 用一次性 ECDH(P256) 临时密钥派生独立密钥 (前向保密)。关闭则允许在重同步时退回到长寿命节点密钥。"
msgstr "Forcer chaque paire de pairs à dériver son propre chiffrement depuis une clé éphémère ECDH(P256) à usage unique (secret de transmission). Désactivé autorise le repli sur la clé de nœud longue durée lors d'une resynchronisation."

msgid "强制认证密钥交换 (Require Auth Key Exchange)"
msgstr "Exiger l'échange de clé authentifié (Require Auth Key Exchange)"

msgid "对每个 Peer 强制身份签名的密钥交换，防止中继跳替换密钥的降级攻击。开启后与未升级的旧节点不建立加密连接；仅在全部节点均已升级的舰队上启用。"
msgstr "Exiger un échange de clé signé par identité de chaque pair, empêchant un saut de relais de transit de substituer sa propre clé. Une fois activé, les liens chiffrés ne s'établissent pas avec les pairs hérités non mis à niveau ; activer uniquement sur des flottes où tous les pairs sont mis à niveau."

msgid "访问控制 (ACL)"
msgstr "Contrôle d'accès (ACL)"

msgid "启用访问控制 (Enable ACL)"
msgstr "Activer le contrôle d'accès (ACL)"

msgid "启用后按默认动作 + 规则列表过滤网格流量。默认关闭 (网格完全开放)。"
msgstr "Une fois activé, le trafic maillé est filtré par l'action par défaut plus la liste de règles. Désactivé par défaut (maillage totalement ouvert)."

msgid "默认动作 (Default Action)"
msgstr "Action par défaut (Default Action)"

msgid "允许 (Allow)"
msgstr "Autoriser (Allow)"

msgid "拒绝 (Deny)"
msgstr "Refuser (Deny)"

msgid "详细 ACL 规则"
msgstr "Règles ACL détaillées"

msgid "细粒度规则 (每条的 rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment) 请通过配置文件手动编辑: /etc/config/p2ptap 或生成的 /tmp/etc/p2ptap.json 的 acl.rules 数组。"
msgstr "Les règles fines (par règle : rule_id / action / direction / peer_id / ip_cidr / protocol / port / comment) doivent être modifiées manuellement dans le fichier de configuration : le tableau acl.rules dans /etc/config/p2ptap ou le /tmp/etc/p2ptap.json généré."

msgid "抓包采样率 (Pcap Sample Every)"
msgstr "Échantillonnage de capture (Pcap Sample Every)"

msgid "实时抓包视图每 N 帧采样 1 帧。1 = 全量。值越大 CPU 越低但抓包越粗。"
msgstr "La vue de capture en direct échantillonne 1 trame sur N. 1 = tout. Plus élevé = CPU plus faible mais capture plus grossière."

msgid "抓包速率上限 (Pcap Max Rate, 帧/秒)"
msgstr "Taux max de capture (Pcap Max Rate, trames/s)"

msgid "限制每秒捕获的帧数 (0 = 不限)。作为 PcapSampleEvery 之上的二级安全网。"
msgstr "Plafonne les trames capturées par seconde (0 = illimité). Un filet de sécurité secondaire au-dessus de PcapSampleEvery."
