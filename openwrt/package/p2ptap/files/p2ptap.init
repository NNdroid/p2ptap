#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CONF="p2ptap"
PROG="/usr/bin/p2ptap"
JSON_CONF="/tmp/etc/p2ptap.json"

generate_json_config() {
	mkdir -p /tmp/etc /etc/p2ptap

	local enabled log_level node_name tap_name tap_ip tap_ipv6 tap_mac mtu strategy enable_mdns discover_boot_mesh psk node_key_file driver_type
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 1

	config_get log_level global log_level "info"
	config_get node_name global node_name ""
	config_get tap_name global tap_name "p2ptap0"
	config_get tap_ip global tap_ip "10.0.0.1/24"
	config_get tap_ipv6 global tap_ipv6 "fd00::1/64"
	config_get tap_mac global tap_mac ""

	# 随机 MAC 生成与持久化逻辑 (兼容 minimal busybox/awk，避免双冒号格式错误)
	if [ -z "$tap_mac" ] || [ "$tap_mac" = "auto" ] || [ ${#tap_mac} -ne 17 ]; then
		local r5
		r5=$(hexdump -n 5 -e '5/1 "%02x "' /dev/urandom 2>/dev/null | awk '{print $1":"$2":"$3":"$4":"$5}')
		if [ -z "$r5" ]; then
			r5=$(dd if=/dev/urandom bs=5 count=1 2>/dev/null | od -An -tx1 | tr -d '\n' | awk '{print $1":"$2":"$3":"$4":"$5}')
		fi
		if [ -n "$r5" ] && [ ${#r5} -eq 14 ]; then
			tap_mac="02:${r5}"
			uci -q set p2ptap.global.tap_mac="$tap_mac"
			uci -q commit p2ptap
		else
			tap_mac=""
		fi
	fi

	config_get mtu global mtu 1500
	config_get strategy global transport_strategy "best_path"
	config_get_bool enable_mdns global enable_mdns 1
	config_get_bool discover_boot_mesh global discover_boot_mesh 1
	config_get psk global psk ""
	config_get node_key_file global node_key_file "/etc/p2ptap/node.key"
	config_get driver_type global driver_type "auto"

	local web_enable web_ip web_ipv6 web_port web_auth_token
	config_get_bool web_enable global webui_enable 1
	config_get web_ip global webui_listen_ip "0.0.0.0"
	config_get web_ipv6 global webui_listen_ipv6 "::"
	config_get web_port global webui_port 5857
	config_get web_auth_token global webui_auth_token ""

	local obfs_enable obfs_mode obfs_algo obfs_fixed obfs_block obfs_jitter obfs_min obfs_max obfs_auto_interval obfs_auto_threshold obfs_allow_switch
	config_get_bool obfs_enable global obfuscation_enable 0
	config_get obfs_mode global obfuscation_mode "fixed"
	config_get obfs_algo global obfuscation_algorithm "auto"
	config_get obfs_fixed global fixed_size 1500
	config_get obfs_block global block_size 256
	config_get obfs_jitter global jitter_range 0
	config_get obfs_min global min_size 128
	config_get obfs_max global max_size 1500
	config_get obfs_auto_interval global auto_detect_interval 30
	config_get obfs_auto_threshold global auto_threshold_bytes 1048576
	config_get_bool obfs_allow_switch global allow_mode_switch 0

	local exit_enable exit_nat exit_wan
	config_get_bool exit_enable global exit_enable 0
	config_get_bool exit_nat global nat_masquerade 0
	config_get exit_wan global wan_interface "auto"

	local accept_subnets
	config_get_bool accept_subnets global accept_advertised_subnets 0

	local t_quic t_webrtc t_webtransport t_tcp t_tcp_brutal t_tcp_brutal_rate t_disable_relay
	config_get_bool t_quic global enable_quic_reuse 1
	config_get_bool t_webrtc global enable_webrtc 1
	config_get_bool t_webtransport global enable_webtransport 1
	config_get_bool t_tcp global enable_tcp_reuse 1
	config_get_bool t_tcp_brutal global enable_tcp_brutal 0
	config_get t_tcp_brutal_rate global tcp_brutal_rate "100Mbps"
	config_get_bool t_disable_relay global disable_relay 0

	# jshn escapes UCI strings and preserves JSON types.
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string log_level "$log_level"
	json_add_string node_name "$node_name"
	json_add_string tap_name "$tap_name"
	json_add_string tap_ip "$tap_ip"
	json_add_string tap_ipv6 "$tap_ipv6"
	json_add_string tap_mac "$tap_mac"
	case "$mtu" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: mtu"; return 1 ;; esac
	json_add_int mtu "$mtu"
	json_add_string driver_type "$driver_type"
	json_add_string transport_strategy "$strategy"
	json_add_boolean enable_mdns "$enable_mdns"
	json_add_boolean discover_boot_mesh "$discover_boot_mesh"
	json_add_string psk "$psk"
	json_add_string node_key_file "$node_key_file"
	json_add_boolean accept_advertised_subnets "$accept_subnets"
	json_add_object web_ui
	json_add_boolean enable "$web_enable"
	json_add_string listen_ip "$web_ip"
	json_add_string listen_ipv6 "$web_ipv6"
	case "$web_port" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: port"; return 1 ;; esac
	json_add_int port "$web_port"
	json_add_string auth_token "$web_auth_token"
	json_close_object
	json_add_object obfuscation
	json_add_boolean enable "$obfs_enable"
	json_add_string mode "$obfs_mode"
	json_add_string algorithm "$obfs_algo"
	case "$obfs_fixed" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: fixed_size"; return 1 ;; esac
	json_add_int fixed_size "$obfs_fixed"
	case "$obfs_block" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: block_size"; return 1 ;; esac
	json_add_int block_size "$obfs_block"
	case "$obfs_jitter" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: jitter_range"; return 1 ;; esac
	json_add_int jitter_range "$obfs_jitter"
	case "$obfs_min" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: min_size"; return 1 ;; esac
	json_add_int min_size "$obfs_min"
	case "$obfs_max" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: max_size"; return 1 ;; esac
	json_add_int max_size "$obfs_max"
	case "$obfs_auto_interval" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: auto_detect_interval"; return 1 ;; esac
	json_add_int auto_detect_interval "$obfs_auto_interval"
	case "$obfs_auto_threshold" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: auto_threshold_bytes"; return 1 ;; esac
	json_add_int auto_threshold_bytes "$obfs_auto_threshold"
	json_add_boolean allow_mode_switch "$obfs_allow_switch"
	json_close_object
	json_add_object exit_node
	json_add_boolean enable "$exit_enable"
	json_add_boolean nat_masquerade "$exit_nat"
	json_add_string wan_interface "$exit_wan"
	json_close_object
	json_add_object transports
	json_add_boolean enable_quic_reuse "$t_quic"
	json_add_boolean enable_webrtc "$t_webrtc"
	json_add_boolean enable_webtransport "$t_webtransport"
	json_add_boolean enable_tcp_reuse "$t_tcp"
	json_add_boolean enable_tcp_brutal "$t_tcp_brutal"
	json_add_string tcp_brutal_rate "$t_tcp_brutal_rate"
	json_add_boolean disable_relay "$t_disable_relay"
	json_close_object
	append_json_string() {
		json_add_string "" "$1"
	}
	json_add_array advertised_subnets
	config_list_foreach global advertised_subnets append_json_string
	json_close_array
	json_add_array allowed_subnet_peers
	config_list_foreach global allowed_subnet_peers append_json_string
	json_close_array
	json_add_array listen_addrs
	config_list_foreach global listen_addrs append_json_string
	json_close_array
	json_add_array bootstrap_peers
	config_list_foreach global bootstrap_peers append_json_string
	json_close_array
	json_add_array static_peers
	config_list_foreach global static_peers append_json_string
	json_close_array
	# Keep credentials private and replace the configuration atomically.
	(umask 077; json_dump > "${JSON_CONF}.new") || return 1
	chmod 600 "${JSON_CONF}.new" || return 1
	mv -f "${JSON_CONF}.new" "$JSON_CONF" || return 1
	return 0
}

start_service() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0
	generate_json_config || return 1

	# 确保 /dev/net/tun 字符设备可用
	if [ ! -c /dev/net/tun ]; then
		mkdir -p /dev/net
		mknod /dev/net/tun c 10 200 2>/dev/null || true
		chmod 0666 /dev/net/tun 2>/dev/null || true
	fi

	procd_open_instance
	procd_set_param command "$PROG" run -c "$JSON_CONF"
	procd_set_param file /etc/config/p2ptap
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "p2ptap"
}

reload_service() {
	restart
}