#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CONF="p2ptap"
PROG="/usr/bin/p2ptap"
JSON_CONF="/tmp/etc/p2ptap.json"

generate_json_config() {
	mkdir -p /tmp/etc /etc/p2ptap

	local enabled log_level node_name tap_name tap_ip tap_ipv6 tap_mac mtu strategy enable_mdns discover_boot_mesh psk node_key_file driver_type
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 1

	config_get log_level global log_level "info"
	config_get node_name global node_name ""
	config_get tap_name global tap_name "p2ptap0"
	config_get tap_ip global tap_ip "10.0.0.1/24"
	config_get tap_ipv6 global tap_ipv6 "fd00::1/64"
	config_get tap_mac global tap_mac ""

	# 新增：随机 MAC 生成与持久化逻辑 (兼容 minimal busybox，不依赖 hexdump)
	if [ -z "$tap_mac" ]; then
		local mac_suffix
		mac_suffix=$(dd if=/dev/urandom bs=5 count=1 2>/dev/null | od -An -tx1 2>/dev/null | tr -s ' ' | tr ' ' ':')
		if [ -n "$mac_suffix" ]; then
			tap_mac="02${mac_suffix}"
		else
			tap_mac="02:$(hexdump -n 5 -e '1/1 "%02x:"' /dev/urandom | sed 's/:$//')"
		fi
		uci -q set p2ptap.global.tap_mac="$tap_mac"
		uci -q commit p2ptap
	fi

	config_get mtu global mtu 1500
	config_get strategy global transport_strategy "best_path"
	config_get_bool enable_mdns global enable_mdns 1
	config_get_bool discover_boot_mesh global discover_boot_mesh 1
	config_get psk global psk ""
	config_get node_key_file global node_key_file "/etc/p2ptap/node.key"
	config_get driver_type global driver_type "auto"

	local web_enable web_ip web_ipv6 web_port web_auth_token
	config_get_bool web_enable global webui_enable 1
	config_get web_ip global webui_listen_ip "0.0.0.0"
	config_get web_ipv6 global webui_listen_ipv6 "::"
	config_get web_port global webui_port 5857
	config_get web_auth_token global webui_auth_token ""

	local obfs_enable obfs_mode obfs_algo obfs_fixed obfs_block obfs_jitter obfs_min obfs_max obfs_auto_interval obfs_auto_threshold obfs_allow_switch
	config_get_bool obfs_enable global obfuscation_enable 1
	config_get obfs_mode global obfuscation_mode "fixed"
	config_get obfs_algo global obfuscation_algorithm "auto"
	config_get obfs_fixed global fixed_size 1500
	config_get obfs_block global block_size 256
	config_get obfs_jitter global jitter_range 0
	config_get obfs_min global min_size 128
	config_get obfs_max global max_size 1500
	config_get obfs_auto_interval global auto_detect_interval 30
	config_get obfs_auto_threshold global auto_threshold_bytes 1048576
	config_get_bool obfs_allow_switch global allow_mode_switch 0

	local exit_enable exit_nat exit_wan
	config_get_bool exit_enable global exit_enable 0
	config_get_bool exit_nat global nat_masquerade 0
	config_get exit_wan global wan_interface "auto"

	local accept_subnets
	config_get_bool accept_subnets global accept_advertised_subnets 0

	local t_quic t_webrtc t_webtransport t_tcp t_tcp_brutal t_tcp_brutal_rate t_disable_relay
	config_get_bool t_quic global enable_quic_reuse 1
	config_get_bool t_webrtc global enable_webrtc 1
	config_get_bool t_webtransport global enable_webtransport 1
	config_get_bool t_tcp global enable_tcp_reuse 1
	config_get_bool t_tcp_brutal global enable_tcp_brutal 0
	config_get t_tcp_brutal_rate global tcp_brutal_rate "100Mbps"
	config_get_bool t_disable_relay global disable_relay 0

	# Format JSON config
	cat <<EOF > "$JSON_CONF"
{
  "log_level": "$log_level",
  "node_name": "$node_name",
  "tap_name": "$tap_name",
  "tap_ip": "$tap_ip",
  "tap_ipv6": "$tap_ipv6",
  "tap_mac": "$tap_mac",
  "mtu": $mtu,
  "driver_type": "$driver_type",
  "transport_strategy": "$strategy",
  "enable_mdns": $([ "$enable_mdns" -eq 1 ] && echo true || echo false),
  "discover_boot_mesh": $([ "$discover_boot_mesh" -eq 1 ] && echo true || echo false),
  "psk": "$psk",
  "node_key_file": "$node_key_file",
  "accept_advertised_subnets": $([ "$accept_subnets" -eq 1 ] && echo true || echo false),
  "web_ui": {
    "enable": $([ "$web_enable" -eq 1 ] && echo true || echo false),
    "listen_ip": "$web_ip",
    "listen_ipv6": "$web_ipv6",
    "port": $web_port,
    "auth_token": "$web_auth_token"
  },
  "obfuscation": {
    "enable": $([ "$obfs_enable" -eq 1 ] && echo true || echo false),
    "mode": "$obfs_mode",
    "algorithm": "$obfs_algo",
    "fixed_size": $obfs_fixed,
    "block_size": $obfs_block,
    "jitter_range": $obfs_jitter,
    "min_size": $obfs_min,
    "max_size": $obfs_max,
    "auto_detect_interval": $obfs_auto_interval,
    "auto_threshold_bytes": $obfs_auto_threshold,
    "allow_mode_switch": $([ "$obfs_allow_switch" -eq 1 ] && echo true || echo false)
  },
  "exit_node": {
    "enable": $([ "$exit_enable" -eq 1 ] && echo true || echo false),
    "nat_masquerade": $([ "$exit_nat" -eq 1 ] && echo true || echo false),
    "wan_interface": "$exit_wan"
  },
  "transports": {
    "enable_quic_reuse": $([ "$t_quic" -eq 1 ] && echo true || echo false),
    "enable_webrtc": $([ "$t_webrtc" -eq 1 ] && echo true || echo false),
    "enable_webtransport": $([ "$t_webtransport" -eq 1 ] && echo true || echo false),
    "enable_tcp_reuse": $([ "$t_tcp" -eq 1 ] && echo true || echo false),
    "enable_tcp_brutal": $([ "$t_tcp_brutal" -eq 1 ] && echo true || echo false),
    "tcp_brutal_rate": "$t_tcp_brutal_rate",
    "disable_relay": $([ "$t_disable_relay" -eq 1 ] && echo true || echo false)
  },
  "advertised_subnets": [
EOF

	local first_subnet=1
	append_subnet() {
		if [ "$first_subnet" -eq 1 ]; then
			echo "    \"$1\"" >> "$JSON_CONF"
			first_subnet=0
		else
			echo "   ,\"$1\"" >> "$JSON_CONF"
		fi
	}
	config_list_foreach global advertised_subnets append_subnet

	cat <<EOF >> "$JSON_CONF"
  ],
  "allowed_subnet_peers": [
EOF

	local first_allowed=1
	append_allowed() {
		if [ "$first_allowed" -eq 1 ]; then
			echo "    \"$1\"" >> "$JSON_CONF"
			first_allowed=0
		else
			echo "   ,\"$1\"" >> "$JSON_CONF"
		fi
	}
	config_list_foreach global allowed_subnet_peers append_allowed

	cat <<EOF >> "$JSON_CONF"
  ],
  "listen_addrs": [
EOF

	# 动态遍历 listen_addrs
	local first_listen=1
	append_listen() {
		if [ "$first_listen" -eq 1 ]; then
			echo "    \"$1\"" >> "$JSON_CONF"
			first_listen=0
		else
			echo "   ,\"$1\"" >> "$JSON_CONF"
		fi
	}
	config_list_foreach global listen_addrs append_listen

	cat <<EOF >> "$JSON_CONF"
  ],
  "bootstrap_peers": [
EOF

	local first=1
	append_bootstrap() {
		if [ "$first" -eq 1 ]; then
			echo "    \"$1\"" >> "$JSON_CONF"
			first=0
		else
			echo "   ,\"$1\"" >> "$JSON_CONF"
		fi
	}
	config_list_foreach global bootstrap_peers append_bootstrap

	cat <<EOF >> "$JSON_CONF"
  ],
  "static_peers": [
EOF

	first=1
	append_static() {
		if [ "$first" -eq 1 ]; then
			echo "    \"$1\"" >> "$JSON_CONF"
			first=0
		else
			echo "   ,\"$1\"" >> "$JSON_CONF"
		fi
	}
	config_list_foreach global static_peers append_static

	cat <<EOF >> "$JSON_CONF"
  ]
}
EOF
	return 0
}

start_service() {
	config_load "$CONF"
	generate_json_config || return 0

	# 确保 /dev/net/tun 字符设备可用
	if [ ! -c /dev/net/tun ]; then
		mkdir -p /dev/net
		mknod /dev/net/tun c 10 200 2>/dev/null || true
		chmod 0666 /dev/net/tun 2>/dev/null || true
	fi

	procd_open_instance
	procd_set_param command "$PROG" run -c "$JSON_CONF"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}