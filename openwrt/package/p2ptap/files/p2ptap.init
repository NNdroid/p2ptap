#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

CONF="p2ptap"
PROG="/usr/bin/p2ptap"
JSON_CONF="/tmp/etc/p2ptap.json"

generate_json_config() {
	mkdir -p /tmp/etc /etc/p2ptap

	local enabled log_level node_name tap_name tap_ip tap_ipv6 tap_mac mtu strategy enable_mdns discover_boot_mesh psk node_key_file driver_type stats_sample_every force_private_reachability
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 1

	config_get log_level global log_level "info"
	config_get node_name global node_name ""
	config_get tap_name global tap_name "p2ptap0"
	config_get tap_ip global tap_ip "10.0.0.1/24"
	config_get tap_ipv6 global tap_ipv6 "fd00::1/64"
	config_get tap_mac global tap_mac ""

	# 随机 MAC 生成与持久化逻辑 (兼容 minimal busybox/awk，避免双冒号格式错误)
	if [ -z "$tap_mac" ] || [ "$tap_mac" = "auto" ] || [ ${#tap_mac} -ne 17 ]; then
		local r5
		r5=$(hexdump -n 5 -e '5/1 "%02x "' /dev/urandom 2>/dev/null | awk '{print $1":"$2":"$3":"$4":"$5}')
		if [ -z "$r5" ]; then
			r5=$(dd if=/dev/urandom bs=5 count=1 2>/dev/null | od -An -tx1 | tr -d '\n' | awk '{print $1":"$2":"$3":"$4":"$5}')
		fi
		if [ -n "$r5" ] && [ ${#r5} -eq 14 ]; then
			tap_mac="02:${r5}"
			uci -q set p2ptap.global.tap_mac="$tap_mac"
			uci -q commit p2ptap
		else
			tap_mac=""
		fi
	fi

	config_get mtu global mtu 1500
	config_get strategy global transport_strategy "best_path"
	config_get_bool enable_mdns global enable_mdns 1
	config_get_bool discover_boot_mesh global discover_boot_mesh 1
	config_get psk global psk ""
	config_get node_key_file global node_key_file "/etc/p2ptap/node.key"
	config_get driver_type global driver_type "auto"
	config_get stats_sample_every global stats_sample_every 1
	config_get_bool force_private_reachability global force_private_reachability 0

	local web_enable web_ip web_ipv6 web_port web_auth_token web_pcap_every web_pcap_rate
	config_get_bool web_enable global webui_enable 1
	config_get web_ip global webui_listen_ip "0.0.0.0"
	config_get web_ipv6 global webui_listen_ipv6 "::"
	config_get web_port global webui_port 5857
	config_get web_auth_token global webui_auth_token ""
	config_get web_pcap_every global pcap_sample_every 1
	config_get web_pcap_rate global pcap_max_rate_per_sec 0

	# 流量混淆与加密 — 与 daemon ObfuscationConfig 对齐:
	# enable / padding_rules / max_frag_size / algorithm / strict_key_negotiation / require_auth_key_exchange
	local obfs_enable obfs_algo obfs_maxfrag obfs_strict obfs_require_auth
	config_get_bool obfs_enable global obfuscation_enable 1
	config_get obfs_algo global obfuscation_algorithm "auto"
	config_get obfs_maxfrag global max_frag_size 0
	config_get_bool obfs_strict global strict_key_negotiation 1
	config_get_bool obfs_require_auth global require_auth_key_exchange 1

	# padding_rules 是 UCI list (DynamicList)，每行一条填充带/coalesce 指令，
	# 用换行拼接为单条多行规则字符串。留空时 daemon 采用默认规则。
	local NL obfs_padding
	NL=$(printf '\n')
	obfs_padding=""
	append_padding_line() {
		if [ -z "$obfs_padding" ]; then
			obfs_padding="$1"
		else
			obfs_padding="${obfs_padding}${NL}$1"
		fi
	}
	config_list_foreach global padding_rules append_padding_line

	local exit_enable exit_nat exit_wan
	config_get_bool exit_enable global exit_enable 0
	config_get_bool exit_nat global nat_masquerade 0
	config_get exit_wan global wan_interface "auto"

	local accept_subnets
	config_get_bool accept_subnets global accept_advertised_subnets 0

	local t_quic t_webrtc t_webrtc_sig t_webtransport t_tcp t_disable_relay t_disable_circuit t_disable_hole tls_server tls_sni t_relay_mh
	config_get_bool t_quic global enable_quic_reuse 1
	config_get_bool t_webrtc global enable_webrtc 1
	config_get_bool t_webrtc_sig global enable_webrtc_signaling 1
	config_get_bool t_webtransport global enable_webtransport 1
	config_get_bool t_tcp global enable_tcp_reuse 1
	config_get tls_server global tls_server_name ""
	config_get tls_sni global tls_sni_suffix ""
	config_get_bool t_disable_circuit global disable_circuit_relay 0
	config_get_bool t_disable_hole global disable_hole_punching 0
	config_get_bool t_disable_relay global disable_relay 0
	config_get_bool t_relay_mh global relay_header_multihash 0

	local rx_reorder_window rx_reorder_delay_ms
	config_get rx_reorder_window global rx_reorder_window 1024
	config_get rx_reorder_delay_ms global rx_reorder_delay_ms 300

	local acl_enable acl_default
	config_get_bool acl_enable global acl_enable 0
	config_get acl_default global acl_default_action "allow"

	# jshn escapes UCI strings and preserves JSON types.
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string log_level "$log_level"
	json_add_string node_name "$node_name"
	json_add_string tap_name "$tap_name"
	json_add_string tap_ip "$tap_ip"
	json_add_string tap_ipv6 "$tap_ipv6"
	json_add_string tap_mac "$tap_mac"
	case "$mtu" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: mtu"; return 1 ;; esac
	json_add_int mtu "$mtu"
	json_add_string driver_type "$driver_type"
	json_add_string transport_strategy "$strategy"
	json_add_boolean enable_mdns "$enable_mdns"
	json_add_boolean discover_boot_mesh "$discover_boot_mesh"
	json_add_string psk "$psk"
	json_add_string node_key_file "$node_key_file"
	case "$stats_sample_every" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: stats_sample_every"; return 1 ;; esac
	json_add_int stats_sample_every "$stats_sample_every"
	json_add_boolean force_private_reachability "$force_private_reachability"
	json_add_boolean accept_advertised_subnets "$accept_subnets"
	case "$rx_reorder_window" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: rx_reorder_window"; return 1 ;; esac
	json_add_int rx_reorder_window "$rx_reorder_window"
	case "$rx_reorder_delay_ms" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: rx_reorder_delay_ms"; return 1 ;; esac
	json_add_int rx_reorder_delay_ms "$rx_reorder_delay_ms"
	json_add_object web_ui
	json_add_boolean enable "$web_enable"
	json_add_string listen_ip "$web_ip"
	json_add_string listen_ipv6 "$web_ipv6"
	case "$web_port" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: port"; return 1 ;; esac
	json_add_int port "$web_port"
	json_add_string auth_token "$web_auth_token"
	case "$web_pcap_every" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: pcap_sample_every"; return 1 ;; esac
	json_add_int pcap_sample_every "$web_pcap_every"
	case "$web_pcap_rate" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: pcap_max_rate_per_sec"; return 1 ;; esac
	json_add_int pcap_max_rate_per_sec "$web_pcap_rate"
	json_close_object
	json_add_object obfuscation
	json_add_boolean enable "$obfs_enable"
	json_add_string padding_rules "$obfs_padding"
	json_add_string algorithm "$obfs_algo"
	case "$obfs_maxfrag" in ''|*[!0-9]*) logger -t p2ptap "Invalid numeric option: max_frag_size"; return 1 ;; esac
	json_add_int max_frag_size "$obfs_maxfrag"
	json_add_boolean strict_key_negotiation "$obfs_strict"
	json_add_boolean require_auth_key_exchange "$obfs_require_auth"
	json_close_object
	json_add_object exit_node
	json_add_boolean enable "$exit_enable"
	json_add_boolean nat_masquerade "$exit_nat"
	json_add_string wan_interface "$exit_wan"
	json_close_object
	json_add_object transports
	json_add_boolean enable_quic_reuse "$t_quic"
	json_add_boolean enable_webrtc "$t_webrtc"
	json_add_boolean enable_webrtc_signaling "$t_webrtc_sig"
	json_add_boolean enable_webtransport "$t_webtransport"
	json_add_boolean enable_tcp_reuse "$t_tcp"
	json_add_string tls_server_name "$tls_server"
	json_add_string tls_sni_suffix "$tls_sni"
	json_add_boolean disable_circuit_relay "$t_disable_circuit"
	json_add_boolean disable_hole_punching "$t_disable_hole"
	json_add_boolean disable_relay "$t_disable_relay"
	json_add_boolean relay_header_multihash "$t_relay_mh"
	json_close_object
	json_add_object acl
	json_add_boolean enable "$acl_enable"
	json_add_string default_action "$acl_default"
	json_add_array rules
	json_close_array
	json_close_object
	append_json_string() {
		json_add_string "" "$1"
	}
	json_add_array advertised_subnets
	config_list_foreach global advertised_subnets append_json_string
	json_close_array
	json_add_array allowed_subnet_peers
	config_list_foreach global allowed_subnet_peers append_json_string
	json_close_array
	json_add_array listen_addrs
	config_list_foreach global listen_addrs append_json_string
	json_close_array
	json_add_array bootstrap_peers
	config_list_foreach global bootstrap_peers append_json_string
	json_close_array
	json_add_array static_peers
	config_list_foreach global static_peers append_json_string
	json_close_array
	json_add_array stun_servers
	config_list_foreach global stun_servers append_json_string
	json_close_array
	json_add_array turn_servers
	config_list_foreach global turn_servers append_json_string
	json_close_array
	# Keep credentials private and replace the configuration atomically.
	(umask 077; json_dump > "${JSON_CONF}.new") || return 1
	chmod 600 "${JSON_CONF}.new" || return 1
	mv -f "${JSON_CONF}.new" "$JSON_CONF" || return 1
	return 0
}

start_service() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0
	generate_json_config || return 1

	# 确保 /dev/net/tun 字符设备可用
	if [ ! -c /dev/net/tun ]; then
		mkdir -p /dev/net
		mknod /dev/net/tun c 10 200 2>/dev/null || true
		chmod 0666 /dev/net/tun 2>/dev/null || true
	fi

	procd_open_instance
	procd_set_param command "$PROG" run -c "$JSON_CONF"
	procd_set_param file /etc/config/p2ptap
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "p2ptap"
}

reload_service() {
	restart
}