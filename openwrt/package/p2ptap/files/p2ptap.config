config p2ptap 'global'
	option enabled '0'
	option log_level 'info'
	option node_name 'openwrt-router'
	option tap_name 'p2ptap0'
	option tap_ip '10.0.0.1/24'
	option tap_ipv6 'fd00::1/64'
	option tap_mac ''
	option mtu '1500'
	option transport_strategy 'best_path'
	option stats_sample_every '1'
	option force_private_reachability '0'
	option enable_mdns '1'
	option discover_boot_mesh '1'
	option psk ''
	option node_key_file '/etc/p2ptap/node.key'
	option driver_type 'auto'

	list listen_addrs '/ip4/0.0.0.0/udp/4001/quic-v1'
	list listen_addrs '/ip6/::/udp/4001/quic-v1'
	list listen_addrs '/ip4/0.0.0.0/udp/4002/webrtc-direct'
	list listen_addrs '/ip6/::/udp/4002/webrtc-direct'
	list listen_addrs '/ip4/0.0.0.0/udp/4003/webtransport'
	list listen_addrs '/ip6/::/udp/4003/webtransport'
	list listen_addrs '/ip4/0.0.0.0/tcp/4001'
	list listen_addrs '/ip6/::/tcp/4001'
	list bootstrap_peers '/dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTmoXMY5PeBKyy1EicV2g7HQ1b18423b'

	# 传输协议 (与 daemon TransportsConfig 对齐)
	option enable_quic_reuse '1'
	option enable_webrtc '1'
	option enable_webrtc_signaling '1'
	option enable_webtransport '1'
	option enable_tcp_reuse '1'
	option tls_server_name ''
	option tls_sni_suffix ''
	option disable_circuit_relay '0'
	option disable_hole_punching '0'
	option disable_relay '0'
	option relay_header_multihash '0'
	# list stun_servers '/udp/stun.l.google.com/19302'
	# list turn_servers 'turn:host:port?username=user&credential=pass'

	# 多径重排缓冲 (仅 transport_strategy='multipath' 生效)
	option rx_reorder_window '1024'
	option rx_reorder_delay_ms '300'

	# 流量混淆与加密 (与 daemon ObfuscationConfig 对齐)
	option obfuscation_enable '1'
	option obfuscation_algorithm 'auto'
	option max_frag_size '0'
	option strict_key_negotiation '1'
	option require_auth_key_exchange '1'
	# list padding_rules '0 -> 400-600'
	# list padding_rules 'coalesce on max_delay_ms=2 max_bytes=1400 max_frames=16'

	# 出口网关（可选）
	option exit_enable '0'
	option nat_masquerade '0'
	option wan_interface 'auto'

	# 访问控制 (ACL)
	option acl_enable '0'
	option acl_default_action 'allow'
	# 细粒度规则 (rule_id/action/direction/peer_id/ip_cidr/protocol/port/comment) 请在生成的
	# /tmp/etc/p2ptap.json 的 acl.rules 数组中手动配置。

	# 内网子网路由（Site-to-Site 互联）
	option accept_advertised_subnets '0'
	# list advertised_subnets '192.168.1.0/24'
	list allowed_subnet_peers '*'

	# WebUI 控制台
	option webui_enable '1'
	option webui_listen_ip '0.0.0.0'
	option webui_listen_ipv6 '::'
	option webui_port '5857'
	option webui_auth_token ''
	option pcap_sample_every '1'
	option pcap_max_rate_per_sec '0'
